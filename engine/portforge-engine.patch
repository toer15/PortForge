+++ b/src/nx/gpu/vk/pipeline.c
@@ -885,6 +885,9 @@ static VkPipeline pipe_wait(Pipe* e, i64 ns) {
    of descriptor sets), and the pipeline's index in this table, pages the GPU thread adds before a stand-in naming
    them goes through the ring. Pipelines live as long as the run, so a stand-in does too */
 #define PIPE_STANDIN   0x5EC6000000000000ull
+#define PIPE_SKIPPABLE 0x0000800000000000ull /* async shaders: the bind may drop its draws (vk_pipeline_skippable) */
+#define ASYNC_WAIT_NS  1500000               /* how long a skippable bind waits for its pipeline before dropping */
+static u64 g_pipe_async_skips;
 #define PSTAND_PAGE    1024
 static Pipe** g_pstand[1024];
 static u32 g_npstand;
@@ -981,17 +984,35 @@ VkPipeline vk_pipeline_get_deferred(const PipeKey* k) {
 }
 /* on the recording thread: the pipeline a handle from vk_pipeline_get_deferred names, waited for while a worker makes
    it. VK_NULL_HANDLE when it couldn't be made */
+static Pipe* standin_pipe(u64 v) {
+    u32 i = (u32)v - 1;
+    return g_pstand[i / PSTAND_PAGE][i % PSTAND_PAGE];
+}
 VkPipeline vk_pipeline_resolve(VkPipeline h) {
     u64 v = (u64)(uintptr_t)h;
+    int skippable = (v & ~(u64)0xFFFFFFFFull) == (PIPE_STANDIN | PIPE_SKIPPABLE);
+    if (skippable) v &= ~PIPE_SKIPPABLE;
     if ((v & ~(u64)0xFFFFFFFFull) != PIPE_STANDIN) return h;
-    u32 i = (u32)v - 1;
-    Pipe* p = g_pstand[i / PSTAND_PAGE][i % PSTAND_PAGE];
+    Pipe* p = standin_pipe(v);
     if (__atomic_load_n(&p->ready, __ATOMIC_ACQUIRE)) return p->p;
     u64 t0 = plat_ns();
-    VkPipeline got = pipe_wait(p, -1);
+    VkPipeline got = pipe_wait(p, skippable ? ASYNC_WAIT_NS : -1);
     __atomic_add_fetch(&g_pipe_wait_ns, plat_ns() - t0, __ATOMIC_RELAXED);
+    if (!got && skippable) __atomic_add_fetch(&g_pipe_async_skips, 1, __ATOMIC_RELAXED);
     return got;
 }
+int vk_pipeline_pending(VkPipeline h) {
+    u64 v = (u64)(uintptr_t)h;
+    if ((v & ~(u64)0xFFFFFFFFull) != PIPE_STANDIN) return 0;
+    return !__atomic_load_n(&standin_pipe(v)->ready, __ATOMIC_ACQUIRE);
+}
+VkPipeline vk_pipeline_skippable(VkPipeline h) {
+    u64 v = (u64)(uintptr_t)h;
+    return (v & ~(u64)0xFFFFFFFFull) == PIPE_STANDIN ? (VkPipeline)(uintptr_t)(v | PIPE_SKIPPABLE) : h;
+}
+u64 vk_pipeline_async_skips(void) {
+    return __atomic_load_n(&g_pipe_async_skips, __ATOMIC_RELAXED);
+}
 void vk_pipeline_stats(u64* pipes, u64* hits, u64* make_ms, u64* wait_ms, u64* shaders, u64* shader_ms) {
     *pipes = g_pipes_new;
     *hits = __atomic_load_n(&g_pipe_hits, __ATOMIC_RELAXED);
