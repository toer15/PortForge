index 0000000..b800061
--- /dev/null
+++ b/src/nx/gpu/vk/upscale.c
@@ -0,0 +1,312 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+/* Presentation-only filters: pixel smoothing (edge antialiasing, smooth.comp) on the guest image, then FSR 1 to the
+   window size. Guest targets, timing, saves and game data are untouched. Three reusable images, no CPU readback or
+   queue idle wait; allocation/format failures use the existing linear blit. Under vk_lock. */
+#include <string.h>
+#include "nx/gpu/vk/vk.h"
+#include "nx/gpu/vk/fsr1_spv.h"
+#include "nx/runtime/platform/log.h"
+
+static struct {
+    VkDescriptorSetLayout ds;
+    VkPipelineLayout layout;
+    VkPipeline pipes[2];
+    VkSampler sampler, bilinear; /* FSR fetches texels itself; smoothing samples between them */
+    /* One scratch pair per frame in flight: frame generation presents twice per game frame and would
+       otherwise overwrite a still-in-flight blit source (edge shimmer / corruption with FSR + FG). */
+    Surf easu[VK_FRAMES], rcas[VK_FRAMES];
+    Surf smooth[VK_FRAMES];
+    VkPipeline smooth_pipe;
+    int smooth_status;
+    int failed;
+    int status;
+    u64 frames;
+} g_upscale;
+
+static int slot(void) { return (int)(vk_frame_id() % VK_FRAMES); }
+
+/* Report transitions, not every frame: a checked setting is not proof that a frame was upscaled. */
+static void report(int status, const char* reason, u32 w, u32 h, u32 dw, u32 dh) {
+    if (g_upscale.status == status) return;
+    g_upscale.status = status;
+    LOG("vulkan: FSR 1 %s, source %ux%u, output %ux%u, %s mode\n", reason, w, h, dw, dh,
+        g_settings.tv_mode ? "TV" : "handheld");
+}
+
+int vk_upscale_init(void) {
+    if (g_upscale.failed) return 0;
+    if (g_upscale.pipes[0] && g_upscale.pipes[1]) return 1;
+    g_upscale.failed = 1; /* a failed setup is retried next launch, never on every frame */
+    VkFormatProperties props;
+    vkGetPhysicalDeviceFormatProperties(g_vk.phys, VK_FORMAT_R16G16B16A16_SFLOAT, &props);
+    VkFormatFeatureFlags required = VK_FORMAT_FEATURE_STORAGE_IMAGE_BIT | VK_FORMAT_FEATURE_SAMPLED_IMAGE_BIT |
+        VK_FORMAT_FEATURE_BLIT_SRC_BIT | VK_FORMAT_FEATURE_SAMPLED_IMAGE_FILTER_LINEAR_BIT;
+    if ((props.optimalTilingFeatures & required) != required) {
+        LOG("vulkan: FSR 1 scratch format unsupported; using linear scaling\n");
+        return 0;
+    }
+    VkDescriptorSetLayoutBinding binds[2] = {
+        {0, VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, 1, VK_SHADER_STAGE_COMPUTE_BIT, NULL},
+        {1, VK_DESCRIPTOR_TYPE_STORAGE_IMAGE, 1, VK_SHADER_STAGE_COMPUTE_BIT, NULL}};
+    VkDescriptorSetLayoutCreateInfo di = {.sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO,
+        .bindingCount = 2, .pBindings = binds};
+    if (!VK_OK(vkCreateDescriptorSetLayout(g_vk.dev, &di, NULL, &g_upscale.ds))) return 0;
+    VkPushConstantRange push = {VK_SHADER_STAGE_COMPUTE_BIT, 0, 32};
+    VkPipelineLayoutCreateInfo li = {.sType = VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO,
+        .setLayoutCount = 1, .pSetLayouts = &g_upscale.ds, .pushConstantRangeCount = 1, .pPushConstantRanges = &push};
+    if (!VK_OK(vkCreatePipelineLayout(g_vk.dev, &li, NULL, &g_upscale.layout))) return 0;
+    VkSamplerCreateInfo si = {.sType = VK_STRUCTURE_TYPE_SAMPLER_CREATE_INFO,
+        .magFilter = VK_FILTER_NEAREST, .minFilter = VK_FILTER_NEAREST,
+        .mipmapMode = VK_SAMPLER_MIPMAP_MODE_NEAREST, .addressModeU = VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE,
+        .addressModeV = VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE, .addressModeW = VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE};
+    if (!VK_OK(vkCreateSampler(g_vk.dev, &si, NULL, &g_upscale.sampler))) return 0;
+    si.magFilter = si.minFilter = VK_FILTER_LINEAR;
+    if (!VK_OK(vkCreateSampler(g_vk.dev, &si, NULL, &g_upscale.bilinear))) return 0;
+    const u32* spv[2] = {fsr_easu_spv, fsr_rcas_spv};
+    u64 sizes[2] = {fsr_easu_spv_size, fsr_rcas_spv_size};
+    for (int i = 0; i < 2; i++) {
+        VkShaderModule module = vk_module_spv(spv[i], sizes[i] / 4);
+        if (!module) return 0;
+        VkComputePipelineCreateInfo ci = {.sType = VK_STRUCTURE_TYPE_COMPUTE_PIPELINE_CREATE_INFO,
+            .stage = {.sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO,
+                .stage = VK_SHADER_STAGE_COMPUTE_BIT, .module = module, .pName = "main"}, .layout = g_upscale.layout};
+        int ok = VK_OK(vkCreateComputePipelines(g_vk.dev, vk_pipeline_cache(), 1, &ci, NULL, &g_upscale.pipes[i]));
+        vkDestroyShaderModule(g_vk.dev, module, NULL);
+        if (!ok) return 0;
+    }
+    g_upscale.failed = 0;
+    LOG("vulkan: AMD FSR 1 EASU + RCAS ready (FP32 spatial upscaling)\n");
+    return 1;
+}
+
+static void drop(Surf* s) {
+    if (s->img) { vk_defer_image(s->img, s->mem, s->att, VK_NULL_HANDLE); vk_defer_bytes(s->bytes); }
+    memset(s, 0, sizeof *s);
+}
+static int image_make(Surf* s, u32 w, u32 h) {
+    if (s->img && s->sw == w && s->sh == h) return 1;
+    drop(s);
+    VkImageCreateInfo ii = {.sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO,
+        .imageType = VK_IMAGE_TYPE_2D, .format = VK_FORMAT_R16G16B16A16_SFLOAT, .extent = {w, h, 1},
+        .mipLevels = 1, .arrayLayers = 1, .samples = VK_SAMPLE_COUNT_1_BIT,
+        .tiling = VK_IMAGE_TILING_OPTIMAL,
+        .usage = VK_IMAGE_USAGE_STORAGE_BIT | VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT};
+    if (!vk_cache_image_create(&ii, &s->img, &s->mem, &s->bytes)) return 0;
+    VkImageViewCreateInfo vi = {.sType = VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO, .image = s->img,
+        .viewType = VK_IMAGE_VIEW_TYPE_2D, .format = ii.format,
+        .subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1}};
+    if (!VK_OK(vkCreateImageView(g_vk.dev, &vi, NULL, &s->att))) { drop(s); return 0; }
+    s->f = (VkFmt){.vk = ii.format, .bpp = 8, .bw = 1, .bh = 1};
+    s->w = s->sw = w; s->h = s->sh = h; s->layers = s->levels = 1;
+    s->type = VK_IMAGE_VIEW_TYPE_2D;
+    return 1;
+}
+
+/* An 8-bit color image the filters can read through a raw view, cropped inside it. */
+static int presentable(const Surf* src, u32 x, u32 y, u32 w, u32 h) {
+    if (!src || !w || !h || x > src->sw || w > src->sw - x || y > src->sh || h > src->sh - y ||
+        src->layers != 1 || src->f.depth || src->f.is_int || src->f.bw != 1 || src->f.bh != 1) return 0;
+    VkFormat raw = vk_srgb_as(src->f.vk, 0);
+    return raw == VK_FORMAT_R8G8B8A8_UNORM || raw == VK_FORMAT_B8G8R8A8_UNORM || raw == VK_FORMAT_A8B8G8R8_UNORM_PACK32;
+}
+
+/* RCAS stops: 0 is sharpest, 2 is nearly off. EASU alone is soft once a Switch image is enlarged
+   (720p to 1080p, 1440p or 4K). Pixel smoothing is off unless the user turns it on; that path stays
+   about a stop softer so the antialias is not sharpened back into jaggies, but not at 2.0,
+   which left the enlarged picture mushy. */
+static float rcas_stops(u32 w, u32 h, u32 dw, u32 dh, int smoothed) {
+    float sx = w ? (float)dw / (float)w : 1.0f;
+    float sy = h ? (float)dh / (float)h : 1.0f;
+    float scale = sx > sy ? sx : sy;
+    float sharp = 0.40f - 0.18f * (scale - 1.0f);
+    if (sharp > 0.38f) sharp = 0.38f;
+    if (sharp < 0.16f) sharp = 0.16f;
+    if (smoothed) {
+        sharp += 1.15f;
+        if (sharp > 1.55f) sharp = 1.55f;
+        if (sharp < 1.30f) sharp = 1.30f;
+    }
+    return sharp;
+}
+static void log_sharp(float sharp, int smoothed) {
+    static int logged_off, logged_on;
+    if (smoothed ? logged_on : logged_off) return;
+    if (smoothed) logged_on = 1;
+    else logged_off = 1;
+    LOG("vulkan: FSR 1 RCAS scale-aware sharpening, %.2f stops (%s)\n", sharp,
+        smoothed ? "pixel smoothing on, lighter sharpen" : "pixel smoothing off, stronger sharpen");
+}
+
+/* EASU then RCAS from input (a raw view of src) into this frame's rcas. srgb: the values are sRGB-encoded. */
+static Surf* fsr_run(VkCommandBuffer cb, Surf* src, VkImageView input, int srgb, u32 x, u32 y, u32 w, u32 h,
+                     u32 dw, u32 dh, float sharpness) {
+    int s = slot();
+    Surf *easu = &g_upscale.easu[s], *rcas = &g_upscale.rcas[s];
+    if (!image_make(easu, dw, dh) || !image_make(rcas, dw, dh)) {
+        drop(easu); drop(rcas); g_upscale.failed = 1;
+        LOG("vulkan: FSR 1 unavailable: no scratch image memory; using linear scaling\n");
+        report(7, "inactive: insufficient scratch memory; standard scaling", w, h, dw, dh);
+        return NULL;
+    }
+    VkDescriptorSet sets[2] = {vk_desc_alloc(g_upscale.ds), vk_desc_alloc(g_upscale.ds)};
+    if (!sets[0] || !sets[1]) { report(8, "inactive: descriptors unavailable; standard scaling", w, h, dw, dh); return NULL; }
+    struct { i32 crop[4]; u32 size[2], srgb; float sharpness; } pc =
+        {{(i32)x, (i32)y, (i32)w, (i32)h}, {dw, dh}, (u32)srgb, sharpness};
+    vk_render_end();
+    Surf* inputs[2] = {src, easu};
+    Surf* outputs[2] = {easu, rcas};
+    for (int i = 0; i < 2; i++) {
+        vk_surf_use(cb, inputs[i], VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL,
+            VK_PIPELINE_STAGE_2_COMPUTE_SHADER_BIT, VK_ACCESS_2_SHADER_SAMPLED_READ_BIT);
+        vk_surf_use(cb, outputs[i], VK_IMAGE_LAYOUT_GENERAL,
+            VK_PIPELINE_STAGE_2_COMPUTE_SHADER_BIT, VK_ACCESS_2_SHADER_STORAGE_WRITE_BIT);
+        VkDescriptorImageInfo images[2] = {
+            {g_upscale.sampler, i ? easu->att : input, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL},
+            {VK_NULL_HANDLE, outputs[i]->att, VK_IMAGE_LAYOUT_GENERAL}};
+        VkWriteDescriptorSet writes[2];
+        for (u32 j = 0; j < 2; j++) writes[j] = (VkWriteDescriptorSet){
+            .sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET, .dstSet = sets[i], .dstBinding = j,
+            .descriptorCount = 1, .descriptorType = j ? VK_DESCRIPTOR_TYPE_STORAGE_IMAGE : VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER,
+            .pImageInfo = &images[j]};
+        vkUpdateDescriptorSets(g_vk.dev, 2, writes, 0, NULL);
+        rec_CmdBindPipeline(cb, VK_PIPELINE_BIND_POINT_COMPUTE, g_upscale.pipes[i]);
+        rec_CmdBindDescriptorSets(cb, VK_PIPELINE_BIND_POINT_COMPUTE, g_upscale.layout, 0, 1, &sets[i], 0, NULL);
+        rec_CmdPushConstants(cb, g_upscale.layout, VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof pc, &pc);
+        rec_CmdDispatch(cb, (dw + 7) / 8, (dh + 7) / 8, 1);
+    }
+    vk_surf_use(cb, rcas, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+        VK_PIPELINE_STAGE_2_BLIT_BIT, VK_ACCESS_2_TRANSFER_READ_BIT);
+    report(1, "active: EASU + RCAS dispatched", w, h, dw, dh);
+    if (++g_upscale.frames == 1 || g_upscale.frames % 600 == 0)
+        LOG("vulkan: FSR 1 upscaled %llu frames, latest %ux%u to %ux%u\n",
+            (unsigned long long)g_upscale.frames, w, h, dw, dh);
+    vk_render_forget_state();
+    return rcas;
+}
+
+/* The reason FSR would not enlarge this crop, as a report status, or 0 when it can. */
+static int fsr_blocked(const Surf* src, u32 x, u32 y, u32 w, u32 h, u32 dw, u32 dh) {
+    if (!src || !w || !h || !dw || !dh || x > src->sw || w > src->sw - x || y > src->sh || h > src->sh - y ||
+        dw > g_vk.props.limits.maxImageDimension2D || dh > g_vk.props.limits.maxImageDimension2D ||
+        src->layers != 1 || src->f.depth || src->f.is_int || src->f.bw != 1 || src->f.bh != 1) {
+        report(2, "inactive: unsupported image or crop; standard scaling", w, h, dw, dh);
+        return 2;
+    }
+    if (dw < w || dh < h || (dw == w && dh == h)) {
+        report(3, "inactive: no enlargement needed; maximize the window to upscale", w, h, dw, dh);
+        return 3;
+    }
+    /* SDR only: preserve float/HDR and unusual formats through the normal path. */
+    if (!presentable(src, x, y, w, h)) {
+        report(4, "inactive: unsupported color format; standard scaling", w, h, dw, dh);
+        return 4;
+    }
+    if (!vk_upscale_init()) {
+        report(5, "inactive: GPU setup unavailable; standard scaling", w, h, dw, dh);
+        return 5;
+    }
+    return 0;
+}
+
+Surf* vk_upscale(VkCommandBuffer cb, Surf* src, u32 x, u32 y, u32 w, u32 h, u32 dw, u32 dh) {
+    if (fsr_blocked(src, x, y, w, h, dw, dh)) return NULL;
+    vk_surf_touch(src); /* scratch allocations may trim the cache; keep this frame's source alive */
+    const VkComponentMapping identity = {0, 0, 0, 0};
+    VkImageView input = vk_tex_view(src, VK_IMAGE_VIEW_TYPE_2D, 0, &identity, 0);
+    if (!input) { report(6, "inactive: input view unavailable; standard scaling", w, h, dw, dh); return NULL; }
+    float sharp = rcas_stops(w, h, dw, dh, 0);
+    log_sharp(sharp, 0);
+    return fsr_run(cb, src, input, vk_srgb_as(src->f.vk, 0) != src->f.vk, x, y, w, h, dw, dh, sharp);
+}
+
+/* Edge antialiasing of the crop into smooth (w x h). keep: leave sRGB values encoded for FSR to read, else store
+   what a blit of the sRGB image would (linear), so either way one encode happens at the swapchain. */
+static Surf* smooth_run(VkCommandBuffer cb, Surf* src, u32 x, u32 y, u32 w, u32 h, int keep) {
+    if (!presentable(src, x, y, w, h) || !vk_upscale_init()) goto unavailable;
+    if (!g_upscale.smooth_pipe) {
+        VkShaderModule module = vk_module_spv(smooth_spv, smooth_spv_size / 4);
+        if (!module) goto unavailable;
+        VkComputePipelineCreateInfo ci = {.sType = VK_STRUCTURE_TYPE_COMPUTE_PIPELINE_CREATE_INFO,
+            .stage = {.sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO,
+                .stage = VK_SHADER_STAGE_COMPUTE_BIT, .module = module, .pName = "main"}, .layout = g_upscale.layout};
+        int ok = VK_OK(vkCreateComputePipelines(g_vk.dev, vk_pipeline_cache(), 1, &ci, NULL, &g_upscale.smooth_pipe));
+        vkDestroyShaderModule(g_vk.dev, module, NULL);
+        if (!ok) goto unavailable;
+    }
+    vk_surf_touch(src);
+    const VkComponentMapping identity = {0, 0, 0, 0};
+    VkImageView input = vk_tex_view(src, VK_IMAGE_VIEW_TYPE_2D, 0, &identity, 0); /* raw: smooth on encoded values */
+    Surf* smooth = &g_upscale.smooth[slot()];
+    if (!input || !image_make(smooth, w, h)) goto unavailable;
+    VkDescriptorSet set = vk_desc_alloc(g_upscale.ds);
+    if (!set) goto unavailable;
+    vk_render_end();
+    vk_surf_use(cb, src, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL,
+        VK_PIPELINE_STAGE_2_COMPUTE_SHADER_BIT, VK_ACCESS_2_SHADER_SAMPLED_READ_BIT);
+    vk_surf_use(cb, smooth, VK_IMAGE_LAYOUT_GENERAL,
+        VK_PIPELINE_STAGE_2_COMPUTE_SHADER_BIT, VK_ACCESS_2_SHADER_STORAGE_WRITE_BIT);
+    VkDescriptorImageInfo images[2] = {
+        {g_upscale.bilinear, input, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL},
+        {VK_NULL_HANDLE, smooth->att, VK_IMAGE_LAYOUT_GENERAL}};
+    VkWriteDescriptorSet writes[2];
+    for (u32 j = 0; j < 2; j++) writes[j] = (VkWriteDescriptorSet){
+        .sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET, .dstSet = set, .dstBinding = j,
+        .descriptorCount = 1, .descriptorType = j ? VK_DESCRIPTOR_TYPE_STORAGE_IMAGE : VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER,
+        .pImageInfo = &images[j]};
+    vkUpdateDescriptorSets(g_vk.dev, 2, writes, 0, NULL);
+    struct { i32 crop[4]; u32 encoded, keep; } pc =
+        {{(i32)x, (i32)y, (i32)w, (i32)h}, vk_srgb_as(src->f.vk, 0) != src->f.vk, (u32)keep};
+    rec_CmdBindPipeline(cb, VK_PIPELINE_BIND_POINT_COMPUTE, g_upscale.smooth_pipe);
+    rec_CmdBindDescriptorSets(cb, VK_PIPELINE_BIND_POINT_COMPUTE, g_upscale.layout, 0, 1, &set, 0, NULL);
+    rec_CmdPushConstants(cb, g_upscale.layout, VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof pc, &pc);
+    rec_CmdDispatch(cb, (w + 7) / 8, (h + 7) / 8, 1);
+    if (!keep) /* FSR's own barriers take the image from here when it follows */
+        vk_surf_use(cb, smooth, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+            VK_PIPELINE_STAGE_2_BLIT_BIT, VK_ACCESS_2_TRANSFER_READ_BIT);
+    vk_render_forget_state();
+    if (g_upscale.smooth_status != 1)
+        LOG("vulkan: Pixel smoothing active: edge antialiasing on the %ux%u game image%s\n", w, h,
+            keep ? " before FSR 1" : "");
+    g_upscale.smooth_status = 1;
+    return smooth;
+unavailable:
+    if (g_upscale.smooth_status != 2) LOG("vulkan: Pixel smoothing unavailable: original presentation retained\n");
+    g_upscale.smooth_status = 2;
+    return NULL;
+}
+
+Surf* vk_pixel_smooth(VkCommandBuffer cb, Surf* src, u32 x, u32 y, u32 w, u32 h) {
+    return g_settings.pixel_smoothing ? smooth_run(cb, src, x, y, w, h, 0) : NULL;
+}
+
+/* Jagged steps are one pixel wide in the game's image and several after enlarging, so smoothing goes first, and
+   only when pixel_smoothing is on. It is off by default: FSR 3 must not blur the picture to hide jaggies.
+   RCAS then sharpens less than the unsmoothed path, or it would put the steps back. */
+Surf* vk_present_filters(VkCommandBuffer cb, Surf* src, u32 x, u32 y, u32 w, u32 h, u32 dw, u32 dh) {
+    if (!g_settings.pixel_smoothing) return g_settings.upscaler ? vk_upscale(cb, src, x, y, w, h, dw, dh) : NULL;
+    if (!g_settings.upscaler || fsr_blocked(src, x, y, w, h, dw, dh)) return smooth_run(cb, src, x, y, w, h, 0);
+    Surf* smoothed = smooth_run(cb, src, x, y, w, h, 1);
+    if (!smoothed) return vk_upscale(cb, src, x, y, w, h, dw, dh);
+    float sharp = rcas_stops(w, h, dw, dh, 1);
+    log_sharp(sharp, 1);
+    Surf* scaled = fsr_run(cb, smoothed, smoothed->att, vk_srgb_as(src->f.vk, 0) != src->f.vk, 0, 0, w, h, dw, dh, sharp);
+    return scaled ? scaled : smooth_run(cb, src, x, y, w, h, 0); /* no FSR scratch: smoothing alone */
+}
+
+void vk_upscale_destroy(void) {
+    for (int i = 0; i < VK_FRAMES; i++) {
+        drop(&g_upscale.smooth[i]);
+        drop(&g_upscale.easu[i]);
+        drop(&g_upscale.rcas[i]);
+    }
+    if (g_upscale.smooth_pipe) vkDestroyPipeline(g_vk.dev, g_upscale.smooth_pipe, NULL);
+    g_upscale.smooth_pipe = VK_NULL_HANDLE; g_upscale.smooth_status = 0;
+    for (int i = 0; i < 2; i++) if (g_upscale.pipes[i]) vkDestroyPipeline(g_vk.dev, g_upscale.pipes[i], NULL);
+    if (g_upscale.sampler) vkDestroySampler(g_vk.dev, g_upscale.sampler, NULL);
+    if (g_upscale.bilinear) vkDestroySampler(g_vk.dev, g_upscale.bilinear, NULL);
+    if (g_upscale.layout) vkDestroyPipelineLayout(g_vk.dev, g_upscale.layout, NULL);
+    if (g_upscale.ds) vkDestroyDescriptorSetLayout(g_vk.dev, g_upscale.ds, NULL);
+    g_upscale.pipes[0] = g_upscale.pipes[1] = VK_NULL_HANDLE; g_upscale.sampler = g_upscale.bilinear = VK_NULL_HANDLE;
+    g_upscale.layout = VK_NULL_HANDLE; g_upscale.ds = VK_NULL_HANDLE; g_upscale.failed = 0;
+    g_upscale.frames = 0; g_upscale.status = 0;
+}
