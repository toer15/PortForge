diff --git a/src/nx/gpu/vk/ffx_fg.c b/src/nx/gpu/vk/ffx_fg.c
new file mode 100644
index 00000000..0f50889d
--- /dev/null
+++ b/src/nx/gpu/vk/ffx_fg.c
@@ -0,0 +1,715 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later
+   Copyright 2026 the ScarletNX contributors */
+/* PortForge FSR 3 with AMD's own passes: the FidelityFX SDK 1.1.4 optical flow and frame interpolation (gpu/vk/ffx,
+   MIT), run by a port of the SDK's host side (sdk/src/components/opticalflow/ffx_opticalflow.cpp and
+   frameinterpolation/ffx_frameinterpolation.cpp: their resources, constants, clears and dispatches, in their order).
+   A Switch game gives no motion vectors or depth the host can name, so the game's motion vectors are zero and its
+   depth flat: AMD's frame interpolation then takes the motion from its optical flow, as AMD's driver-side frame
+   generation does, and a zero vector keeps what stays in place (a HUD) where it is. Each pass binds its resources by
+   the names its SPIR-V keeps (r_input_color, rw_optical_flow, cbFI...), as AMD's backends do from reflection.
+   The frames are 8-bit pictures read and written through R8G8B8A8_UNORM views, bytes as they are. Under vk_lock */
+#include <math.h>
+#include <stdlib.h>
+#include <string.h>
+#include "nx/gpu/vk/vk.h"
+#include "nx/gpu/vk/ffx_spv.h"
+#include "nx/runtime/platform/log.h"
+
+#define PASS_ENUM(n) P_##n,
+enum { FFX_PASSES(PASS_ENUM) PASS_COUNT };
+enum { OF_LEVELS = 7, BINDS = 24, PYRAMID_MIPS = 13 };
+
+typedef struct {
+    char name[48];
+    u32 binding, count;
+    VkDescriptorType type;
+} Bind;
+typedef struct {
+    VkDescriptorSetLayout dsl;
+    VkPipelineLayout layout;
+    VkPipeline pipe;
+    Bind bind[BINDS];
+    int n;
+} Pass;
+typedef struct {
+    VkImage img;
+    VmaAllocation mem;
+    u64 bytes;
+    VkImageView view;              /* every level */
+    VkImageView mip[PYRAMID_MIPS]; /* each level alone, for the pyramid's writes */
+    u32 w, h, levels;
+    VkFormat fmt;
+    int general; /* in VK_IMAGE_LAYOUT_GENERAL, where every pass uses it */
+} Img;
+/* one binding's resource for a dispatch, by its name in the pass */
+typedef struct {
+    const char* name;
+    VkImageView view;
+    VkBuffer buf;
+    u64 off, range;
+} Use;
+
+static struct {
+    int failed, ready, logged;
+    Pass pass[PASS_COUNT];
+    VkSampler linear;
+    VkDescriptorPool pool[VK_FRAMES];
+    u64 pool_frame[VK_FRAMES];
+    u32 w, h;
+    /* optical flow */
+    Img of_in[2][OF_LEVELS], of_vec[2][OF_LEVELS], scd_hist, scd_prev, scd_temp, flow, scd;
+    u32 of_index; /* resourceFrameIndex */
+    i32 of_frame;
+    /* frame interpolation */
+    Img depth, mvs, dil_depth, dil_mvs, prev_depth, interp_depth, game_x, game_y, flow_x, flow_y, pyramid,
+        disocclusion, distortion, dummy_uint;
+    VkBuffer counters;
+    VmaAllocation counters_mem;
+    int counters_zeroed;
+    u64 made;
+} g;
+
+/* ---- the passes, reflected from their SPIR-V */
+enum {
+    OP_NAME = 5, OP_TYPE_IMAGE = 25, OP_TYPE_SAMPLER = 26, OP_TYPE_ARRAY = 28, OP_TYPE_STRUCT = 30, OP_TYPE_POINTER = 32,
+    OP_CONSTANT = 43, OP_VARIABLE = 59, OP_DECORATE = 71
+};
+enum { DEC_BUFFER_BLOCK = 3, DEC_BINDING = 33 };
+enum { SC_UNIFORM_CONSTANT = 0, SC_UNIFORM = 2, SC_STORAGE_BUFFER = 12 };
+static int reflect(const u32* w, size_t n, Pass* p) {
+    u32 bound, i, len;
+    if (n < 5 || w[0] != 0x07230203u) return 0;
+    bound = w[3];
+    const char** name = calloc(bound, sizeof *name);
+    u32 *binding = malloc(bound * 4), *ptr_type = calloc(bound, 4), *ptr_class = calloc(bound, 4),
+        *var_type = calloc(bound, 4), *kind = calloc(bound, 4), *elem = calloc(bound, 4), *len_id = calloc(bound, 4),
+        *value = calloc(bound, 4);
+    u8* is_var = calloc(bound, 1);
+    int ok = name && binding && ptr_type && ptr_class && var_type && kind && elem && len_id && value && is_var;
+    if (ok) memset(binding, 0xFF, bound * 4);
+    /* kind: 1 sampled image, 2 storage image, 3 sampler, 4 buffer block struct */
+    for (i = 5; ok && i < n; i += len) {
+        u32 op = w[i] & 0xFFFF;
+        len = w[i] >> 16;
+        if (!len || i + len > n) {
+            ok = 0;
+            break;
+        }
+        if (op == OP_NAME && len > 2 && w[i + 1] < bound) name[w[i + 1]] = (const char*)&w[i + 2];
+        else if (op == OP_DECORATE && len > 3 && w[i + 1] < bound && w[i + 2] == DEC_BINDING) binding[w[i + 1]] = w[i + 3];
+        else if (op == OP_DECORATE && len > 2 && w[i + 1] < bound && w[i + 2] == DEC_BUFFER_BLOCK) kind[w[i + 1]] = 4;
+        else if (op == OP_TYPE_IMAGE && len > 7 && w[i + 1] < bound) kind[w[i + 1]] = w[i + 7] == 2 ? 2 : 1;
+        else if (op == OP_TYPE_SAMPLER && w[i + 1] < bound) kind[w[i + 1]] = 3;
+        else if (op == OP_TYPE_ARRAY && len > 3 && w[i + 1] < bound) {
+            elem[w[i + 1]] = w[i + 2];
+            len_id[w[i + 1]] = w[i + 3];
+        } else if (op == OP_TYPE_POINTER && len > 3 && w[i + 1] < bound) {
+            ptr_class[w[i + 1]] = w[i + 2];
+            ptr_type[w[i + 1]] = w[i + 3];
+        } else if (op == OP_CONSTANT && len > 3 && w[i + 2] < bound)
+            value[w[i + 2]] = w[i + 3];
+        else if (op == OP_VARIABLE && len > 3 && w[i + 2] < bound) {
+            is_var[w[i + 2]] = 1;
+            var_type[w[i + 2]] = w[i + 1];
+        }
+    }
+    p->n = 0;
+    for (i = 0; ok && i < bound; i++) {
+        u32 t, cls, count = 1;
+        VkDescriptorType type;
+        if (!is_var[i] || binding[i] == ~0u || var_type[i] >= bound) continue;
+        t = ptr_type[var_type[i]];
+        cls = ptr_class[var_type[i]];
+        if (t < bound && elem[t] && len_id[t] < bound) {
+            count = value[len_id[t]];
+            t = elem[t];
+        }
+        if (t >= bound) continue;
+        if (cls == SC_STORAGE_BUFFER || (cls == SC_UNIFORM && kind[t] == 4))
+            type = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER;
+        else if (cls == SC_UNIFORM)
+            type = VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER;
+        else if (cls == SC_UNIFORM_CONSTANT && kind[t] == 1)
+            type = VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE;
+        else if (cls == SC_UNIFORM_CONSTANT && kind[t] == 2)
+            type = VK_DESCRIPTOR_TYPE_STORAGE_IMAGE;
+        else if (cls == SC_UNIFORM_CONSTANT && kind[t] == 3)
+            type = VK_DESCRIPTOR_TYPE_SAMPLER;
+        else
+            continue;
+        if (p->n == BINDS || !name[i]) {
+            ok = 0;
+            break;
+        }
+        Bind* b = &p->bind[p->n++];
+        snprintf(b->name, sizeof b->name, "%s", name[i]);
+        b->binding = binding[i];
+        b->count = count ? count : 1;
+        b->type = type;
+    }
+    free(name), free(binding), free(ptr_type), free(ptr_class), free(var_type), free(kind), free(elem), free(len_id);
+    free(value), free(is_var);
+    return ok && p->n;
+}
+static int pass_make(Pass* p, const u32* spv, u64 bytes) {
+    VkDescriptorSetLayoutBinding b[BINDS];
+    VkShaderModule m;
+    int ok;
+    if (!reflect(spv, (size_t)(bytes / 4), p)) return 0;
+    for (int i = 0; i < p->n; i++)
+        b[i] = (VkDescriptorSetLayoutBinding){p->bind[i].binding, p->bind[i].type, p->bind[i].count,
+                                              VK_SHADER_STAGE_COMPUTE_BIT, NULL};
+    VkDescriptorSetLayoutCreateInfo di = {.sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO,
+                                          .bindingCount = (u32)p->n, .pBindings = b};
+    if (!VK_OK(vkCreateDescriptorSetLayout(g_vk.dev, &di, NULL, &p->dsl))) return 0;
+    VkPipelineLayoutCreateInfo li = {.sType = VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO, .setLayoutCount = 1,
+                                     .pSetLayouts = &p->dsl};
+    if (!VK_OK(vkCreatePipelineLayout(g_vk.dev, &li, NULL, &p->layout))) return 0;
+    if (!(m = vk_module_spv(spv, (size_t)(bytes / 4)))) return 0;
+    VkComputePipelineCreateInfo ci = {
+        .sType = VK_STRUCTURE_TYPE_COMPUTE_PIPELINE_CREATE_INFO,
+        .stage = {.sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO, .stage = VK_SHADER_STAGE_COMPUTE_BIT,
+                  .module = m, .pName = "main"},
+        .layout = p->layout};
+    ok = VK_OK(vkCreateComputePipelines(g_vk.dev, vk_pipeline_cache(), 1, &ci, NULL, &p->pipe));
+    vkDestroyShaderModule(g_vk.dev, m, NULL);
+    return ok;
+}
+
+/* ---- images */
+static VkImageView img_view(VkImage img, VkFormat f, u32 level, u32 levels) {
+    VkImageView v = VK_NULL_HANDLE;
+    VkImageViewCreateInfo vi = {.sType = VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO, .image = img,
+                                .viewType = VK_IMAGE_VIEW_TYPE_2D, .format = f,
+                                .subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, level, levels, 0, 1}};
+    return VK_OK(vkCreateImageView(g_vk.dev, &vi, NULL, &v)) ? v : VK_NULL_HANDLE;
+}
+static void img_drop(Img* m) {
+    if (m->img) {
+        for (u32 i = 0; i < PYRAMID_MIPS; i++)
+            if (m->mip[i]) vkDestroyImageView(g_vk.dev, m->mip[i], NULL);
+        vk_defer_image(m->img, m->mem, m->view, VK_NULL_HANDLE);
+        vk_defer_bytes(m->bytes);
+    }
+    memset(m, 0, sizeof *m);
+}
+static int img(Img* m, VkFormat f, u32 w, u32 h, u32 levels) {
+    if (w < 1) w = 1;
+    if (h < 1) h = 1;
+    if (m->img && m->w == w && m->h == h && m->fmt == f && m->levels == levels) return 1;
+    img_drop(m);
+    VkImageCreateInfo ii = {.sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO, .imageType = VK_IMAGE_TYPE_2D, .format = f,
+                            .extent = {w, h, 1}, .mipLevels = levels, .arrayLayers = 1,
+                            .samples = VK_SAMPLE_COUNT_1_BIT, .tiling = VK_IMAGE_TILING_OPTIMAL,
+                            .usage = VK_IMAGE_USAGE_STORAGE_BIT | VK_IMAGE_USAGE_SAMPLED_BIT |
+                                     VK_IMAGE_USAGE_TRANSFER_DST_BIT};
+    if (!vk_cache_image_create(&ii, &m->img, &m->mem, &m->bytes)) return 0;
+    m->w = w, m->h = h, m->fmt = f, m->levels = levels;
+    if (!(m->view = img_view(m->img, f, 0, levels))) goto fail;
+    if (levels > 1)
+        for (u32 i = 0; i < PYRAMID_MIPS; i++) /* levels past the last write to the last */
+            if (!(m->mip[i] = img_view(m->img, f, i < levels ? i : levels - 1, 1))) goto fail;
+    return 1;
+fail:
+    img_drop(m);
+    return 0;
+}
+/* every image of the passes in GENERAL, where they stay: a new one's first use moves it there */
+static void general(VkCommandBuffer cb, Img* m) {
+    if (m->general) return;
+    VkImageMemoryBarrier2 b = {.sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER_2,
+                               .srcStageMask = VK_PIPELINE_STAGE_2_NONE,
+                               .dstStageMask = VK_PIPELINE_STAGE_2_COMPUTE_SHADER_BIT | VK_PIPELINE_STAGE_2_CLEAR_BIT,
+                               .dstAccessMask = VK_ACCESS_2_SHADER_READ_BIT | VK_ACCESS_2_SHADER_WRITE_BIT |
+                                                VK_ACCESS_2_TRANSFER_WRITE_BIT,
+                               .oldLayout = VK_IMAGE_LAYOUT_UNDEFINED, .newLayout = VK_IMAGE_LAYOUT_GENERAL,
+                               .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+                               .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED, .image = m->img,
+                               .subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, m->levels, 0, 1}};
+    VkDependencyInfo di = {.sType = VK_STRUCTURE_TYPE_DEPENDENCY_INFO, .imageMemoryBarrierCount = 1,
+                           .pImageMemoryBarriers = &b};
+    rec_CmdPipelineBarrier2(cb, &di);
+    m->general = 1;
+}
+/* each pass sees what the ones before it wrote, as AMD's backend barriers between its jobs */
+static void sync(VkCommandBuffer cb) {
+    VkMemoryBarrier2 mb = {.sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER_2,
+                           .srcStageMask = VK_PIPELINE_STAGE_2_COMPUTE_SHADER_BIT | VK_PIPELINE_STAGE_2_CLEAR_BIT,
+                           .srcAccessMask = VK_ACCESS_2_SHADER_WRITE_BIT | VK_ACCESS_2_TRANSFER_WRITE_BIT,
+                           .dstStageMask = VK_PIPELINE_STAGE_2_COMPUTE_SHADER_BIT | VK_PIPELINE_STAGE_2_CLEAR_BIT,
+                           .dstAccessMask = VK_ACCESS_2_SHADER_READ_BIT | VK_ACCESS_2_SHADER_WRITE_BIT |
+                                            VK_ACCESS_2_TRANSFER_WRITE_BIT};
+    VkDependencyInfo di = {.sType = VK_STRUCTURE_TYPE_DEPENDENCY_INFO, .memoryBarrierCount = 1,
+                           .pMemoryBarriers = &mb};
+    rec_CmdPipelineBarrier2(cb, &di);
+}
+static void clear_u(VkCommandBuffer cb, Img* m, u32 v) {
+    VkClearColorValue c = {.uint32 = {v, v, v, v}};
+    VkImageSubresourceRange r = {VK_IMAGE_ASPECT_COLOR_BIT, 0, m->levels, 0, 1};
+    general(cb, m);
+    rec_CmdClearColorImage(cb, m->img, VK_IMAGE_LAYOUT_GENERAL, &c, 1, &r);
+}
+static void clear_f(VkCommandBuffer cb, Img* m, float v) {
+    VkClearColorValue c = {.float32 = {v, v, v, v}};
+    VkImageSubresourceRange r = {VK_IMAGE_ASPECT_COLOR_BIT, 0, m->levels, 0, 1};
+    general(cb, m);
+    rec_CmdClearColorImage(cb, m->img, VK_IMAGE_LAYOUT_GENERAL, &c, 1, &r);
+}
+
+/* ---- dispatches */
+/* a constant block in this frame's staging memory */
+static int cbuf(Use* u, const char* name, const void* data, u64 size) {
+    VkBuffer b;
+    u64 off;
+    u8* p = vk_stage(size, vk_stage_align(), &b, &off);
+    if (!p) return 0;
+    memcpy(p, data, size);
+    *u = (Use){name, VK_NULL_HANDLE, b, off, size};
+    return 1;
+}
+static VkDescriptorSet set_alloc(const Pass* p) {
+    u32 slot = vk_frame_slot();
+    u64 frame = vk_frame_id();
+    VkDescriptorSet set = VK_NULL_HANDLE;
+    if (!g.pool[slot]) {
+        VkDescriptorPoolSize sz[] = {{VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE, 2048}, {VK_DESCRIPTOR_TYPE_STORAGE_IMAGE, 2048},
+                                     {VK_DESCRIPTOR_TYPE_SAMPLER, 256}, {VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER, 512},
+                                     {VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, 256}};
+        VkDescriptorPoolCreateInfo pi = {.sType = VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO, .maxSets = 256,
+                                         .poolSizeCount = 5, .pPoolSizes = sz};
+        if (!VK_OK(vkCreateDescriptorPool(g_vk.dev, &pi, NULL, &g.pool[slot]))) return VK_NULL_HANDLE;
+        g.pool_frame[slot] = frame;
+    } else if (g.pool_frame[slot] != frame) { /* the slot's last frame is done: vk_cmd waited for it */
+        vkResetDescriptorPool(g_vk.dev, g.pool[slot], 0);
+        g.pool_frame[slot] = frame;
+    }
+    VkDescriptorSetAllocateInfo ai = {.sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO,
+                                      .descriptorPool = g.pool[slot], .descriptorSetCount = 1, .pSetLayouts = &p->dsl};
+    return VK_OK(vkAllocateDescriptorSets(g_vk.dev, &ai, &set)) ? set : VK_NULL_HANDLE;
+}
+/* pass `which` over gx x gy x gz groups, each of its bindings given by name in u */
+static int run(VkCommandBuffer cb, int which, const Use* u, int nu, u32 gx, u32 gy, u32 gz) {
+    const Pass* p = &g.pass[which];
+    VkWriteDescriptorSet wr[BINDS];
+    VkDescriptorImageInfo ii[BINDS][PYRAMID_MIPS];
+    VkDescriptorBufferInfo bi[BINDS];
+    VkDescriptorSet set = set_alloc(p);
+    if (!set) return 0;
+    for (int i = 0; i < p->n; i++) {
+        const Bind* b = &p->bind[i];
+        const Use* found = NULL;
+        for (int k = 0; k < nu && !found; k++)
+            if (!strcmp(u[k].name, b->name)) found = &u[k];
+        if (b->type == VK_DESCRIPTOR_TYPE_SAMPLER) {
+            ii[i][0] = (VkDescriptorImageInfo){g.linear, VK_NULL_HANDLE, VK_IMAGE_LAYOUT_UNDEFINED};
+        } else if (!found) {
+            if (!g.logged) LOG("vulkan: FSR 3 (AMD): pass %d has no resource for %s\n", which, b->name);
+            g.logged = 1;
+            return 0;
+        }
+        wr[i] = (VkWriteDescriptorSet){.sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET, .dstSet = set,
+                                       .dstBinding = b->binding, .descriptorCount = b->count,
+                                       .descriptorType = b->type};
+        if (b->type == VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER || b->type == VK_DESCRIPTOR_TYPE_STORAGE_BUFFER) {
+            bi[i] = (VkDescriptorBufferInfo){found->buf, found->off, found->range};
+            wr[i].descriptorCount = 1;
+            wr[i].pBufferInfo = &bi[i];
+        } else {
+            if (b->type != VK_DESCRIPTOR_TYPE_SAMPLER)
+                for (u32 c = 0; c < b->count && c < PYRAMID_MIPS; c++)
+                    ii[i][c] = (VkDescriptorImageInfo){VK_NULL_HANDLE, found->view, VK_IMAGE_LAYOUT_GENERAL};
+            if (wr[i].descriptorCount > PYRAMID_MIPS) wr[i].descriptorCount = PYRAMID_MIPS;
+            wr[i].pImageInfo = ii[i];
+        }
+    }
+    vkUpdateDescriptorSets(g_vk.dev, (u32)p->n, wr, 0, NULL);
+    rec_CmdBindPipeline(cb, VK_PIPELINE_BIND_POINT_COMPUTE, p->pipe);
+    rec_CmdBindDescriptorSets(cb, VK_PIPELINE_BIND_POINT_COMPUTE, p->layout, 0, 1, &set, 0, NULL);
+    rec_CmdDispatch(cb, gx ? gx : 1, gy ? gy : 1, gz ? gz : 1);
+    sync(cb);
+    return 1;
+}
+#define IMG(n, m) ((Use){n, (m)->view, VK_NULL_HANDLE, 0, 0})
+#define VIEW(n, v) ((Use){n, v, VK_NULL_HANDLE, 0, 0})
+
+/* ffxSpdSetup (ffx_spd.h): the downsampler's groups and its constants for a w x h rectangle */
+static void spd_setup(u32 w, u32 h, int mips, u32 groups[2], u32 offset[2], u32 count_mips[2]) {
+    offset[0] = offset[1] = 0;
+    groups[0] = (w - 1) / 64 + 1;
+    groups[1] = (h - 1) / 64 + 1;
+    count_mips[0] = groups[0] * groups[1];
+    if (mips >= 0)
+        count_mips[1] = (u32)mips;
+    else {
+        u32 r = w > h ? w : h;
+        double l = floor(log2((double)r));
+        count_mips[1] = (u32)(l < 12 ? l : 12);
+    }
+}
+
+/* ---- setup */
+static int setup(void) {
+    if (g.failed) return 0;
+    if (g.ready) return 1;
+    g.failed = 1; /* tried once a run */
+    static const u32* const spv[PASS_COUNT] = {
+#define SPV_PTR(n) ffx_##n##_spv,
+        FFX_PASSES(SPV_PTR)};
+    const u64 size[PASS_COUNT] = {
+#define SPV_SIZE(n) ffx_##n##_spv_size,
+        FFX_PASSES(SPV_SIZE)};
+    for (int i = 0; i < PASS_COUNT; i++)
+        if (!pass_make(&g.pass[i], spv[i], size[i])) {
+            LOG("vulkan: FSR 3 (AMD) unavailable: pass %d could not be made\n", i);
+            return 0;
+        }
+    VkSamplerCreateInfo si = {.sType = VK_STRUCTURE_TYPE_SAMPLER_CREATE_INFO, .magFilter = VK_FILTER_LINEAR,
+                              .minFilter = VK_FILTER_LINEAR, .mipmapMode = VK_SAMPLER_MIPMAP_MODE_LINEAR,
+                              .addressModeU = VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE,
+                              .addressModeV = VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE,
+                              .addressModeW = VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE, .maxLod = VK_LOD_CLAMP_NONE};
+    if (!VK_OK(vkCreateSampler(g_vk.dev, &si, NULL, &g.linear))) return 0;
+    VkBufferCreateInfo bi = {.sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO, .size = 256,
+                             .usage = VK_BUFFER_USAGE_STORAGE_BUFFER_BIT | VK_BUFFER_USAGE_TRANSFER_DST_BIT,
+                             .sharingMode = VK_SHARING_MODE_EXCLUSIVE};
+    VmaAllocationCreateInfo ai = {.usage = VMA_MEMORY_USAGE_AUTO_PREFER_DEVICE};
+    if (!VK_OK(vmaCreateBuffer(g_vk.vma, &bi, &ai, &g.counters, &g.counters_mem, NULL))) return 0;
+    g.failed = 0;
+    g.ready = 1;
+    LOG("vulkan: FSR 3 frame generation: AMD FidelityFX SDK 1.1.4 optical flow and frame interpolation ready\n");
+    return 1;
+}
+/* the images for w x h frames: AMD's sizes (opticalflowCreate, frameinterpolationCreate) */
+static int images(u32 w, u32 h) {
+    u32 vw = (w + 7) / 8, vh = (h + 7) / 8;
+    if (g.w == w && g.h == h) return 1;
+    vk_finish(); /* no frame in flight still uses the old ones */
+    g.w = g.h = 0;
+    for (int f = 0; f < 2; f++) {
+        u32 lw = vw, lh = vh;
+        for (int l = 0; l < OF_LEVELS; l++) {
+            if (!img(&g.of_in[f][l], VK_FORMAT_R8_UINT, w >> l, h >> l, 1) ||
+                !img(&g.of_vec[f][l], VK_FORMAT_R16G16_SINT, lw, lh, 1))
+                return 0;
+            lw = (lw + 1) / 2, lh = (lh + 1) / 2;
+        }
+    }
+    u32 levels = 1, pw = w / 2, ph = h / 2;
+    for (u32 r = pw > ph ? pw : ph; r > 1 && levels < PYRAMID_MIPS; r /= 2) levels++;
+    if (!img(&g.scd_hist, VK_FORMAT_R32_UINT, 256 * 9, 1, 1) || !img(&g.scd_prev, VK_FORMAT_R32_SFLOAT, 256 * 9, 1, 1) ||
+        !img(&g.scd_temp, VK_FORMAT_R32_UINT, 3, 1, 1) || !img(&g.flow, VK_FORMAT_R16G16_SINT, vw, vh, 1) ||
+        !img(&g.scd, VK_FORMAT_R32_UINT, 3, 1, 1) || !img(&g.depth, VK_FORMAT_R32_SFLOAT, w, h, 1) ||
+        !img(&g.mvs, VK_FORMAT_R16G16_SFLOAT, w, h, 1) || !img(&g.dil_depth, VK_FORMAT_R32_SFLOAT, w, h, 1) ||
+        !img(&g.dil_mvs, VK_FORMAT_R16G16_SFLOAT, w, h, 1) || !img(&g.prev_depth, VK_FORMAT_R32_UINT, w, h, 1) ||
+        !img(&g.interp_depth, VK_FORMAT_R32_UINT, w, h, 1) || !img(&g.game_x, VK_FORMAT_R32_UINT, w, h, 1) ||
+        !img(&g.game_y, VK_FORMAT_R32_UINT, w, h, 1) || !img(&g.flow_x, VK_FORMAT_R32_UINT, w, h, 1) ||
+        !img(&g.flow_y, VK_FORMAT_R32_UINT, w, h, 1) ||
+        !img(&g.pyramid, VK_FORMAT_R16G16B16A16_SFLOAT, pw, ph, levels) ||
+        !img(&g.disocclusion, VK_FORMAT_R8G8_UNORM, w, h, 1) || !img(&g.distortion, VK_FORMAT_R8G8_UNORM, 1, 1, 1) ||
+        !img(&g.dummy_uint, VK_FORMAT_R32_UINT, 1, 1, 1))
+        return 0;
+    g.w = w, g.h = h;
+    return 1;
+}
+
+/* ---- optical flow: ffxOpticalflowDispatch */
+typedef struct {
+    i32 resolution[2];
+    u32 level, levels;
+    i32 frame;
+    u32 transfer;
+    float lum[2];
+} OfConstants;
+typedef struct {
+    u32 mips, groups, offset[2], groups_pyramid, pad[3];
+} OfSpdConstants;
+static int of_dispatch(VkCommandBuffer cb, VkImageView color, int reset) {
+    OfConstants k = {{(i32)g.w, (i32)g.h}, 0, OF_LEVELS, 0, 0, {0, 0}};
+    OfSpdConstants spd;
+    Use u[8];
+    u32 groups[2], offset[2], counts[2];
+    int odd = g.of_index & 1, a = odd ? 1 : 0, b = !a;
+    g.of_frame = reset ? 0 : g.of_frame + 1;
+    k.frame = g.of_frame;
+    if (reset) {
+        clear_u(cb, &g.scd_temp, 0);
+        clear_u(cb, &g.scd, 0);
+        clear_u(cb, &g.scd_hist, 0);
+        clear_f(cb, &g.scd_prev, 0);
+        for (int f = 0; f < 2; f++)
+            for (int l = 0; l < OF_LEVELS; l++) clear_u(cb, &g.of_in[f][l], 0);
+        sync(cb);
+    }
+    spd_setup(g.w, g.h, 4, groups, offset, counts);
+    spd = (OfSpdConstants){counts[1], counts[0], {offset[0], offset[1]}, counts[0], {0, 0, 0}};
+    /* luma, its pyramid, the scene change histogram and its divergence */
+    if (!cbuf(&u[0], "cbOF", &k, sizeof k)) return 0;
+    u[1] = VIEW("r_input_color", color);
+    u[2] = IMG("rw_optical_flow_input", &g.of_in[a][0]);
+    if (!run(cb, P_of_luma, u, 3, ((g.w + 1) / 2 + 15) / 16, ((g.h + 1) / 2 + 15) / 16, 1)) return 0;
+    if (!cbuf(&u[1], "cbOF_SPD", &spd, sizeof spd)) return 0;
+    u[2] = IMG("rw_optical_flow_input", &g.of_in[a][0]);
+    static const char* const level_names[OF_LEVELS] = {NULL, "rw_optical_flow_input_level_1",
+        "rw_optical_flow_input_level_2", "rw_optical_flow_input_level_3", "rw_optical_flow_input_level_4",
+        "rw_optical_flow_input_level_5", "rw_optical_flow_input_level_6"};
+    {
+        Use pu[9] = {u[0], u[1], u[2]};
+        for (int l = 1; l < OF_LEVELS; l++) pu[2 + l] = IMG(level_names[l], &g.of_in[a][l]);
+        if (!run(cb, P_of_pyramid, pu, 9, groups[0], groups[1], 1)) return 0;
+    }
+    u[1] = IMG("r_optical_flow_input", &g.of_in[a][0]);
+    u[2] = IMG("rw_optical_flow_scd_histogram", &g.scd_hist);
+    if (!run(cb, P_of_scd_histogram, u, 3, ((g.w / 4) / 3 + 31) / 32, 16, 9)) return 0;
+    u[1] = IMG("rw_optical_flow_scd_histogram", &g.scd_hist);
+    u[2] = IMG("rw_optical_flow_scd_previous_histogram", &g.scd_prev);
+    u[3] = IMG("rw_optical_flow_scd_temp", &g.scd_temp);
+    u[4] = IMG("rw_optical_flow_scd_output", &g.scd);
+    if (!run(cb, P_of_scd_divergence, u, 5, 9, 3, 1)) return 0;
+    /* the search, coarse to fine, each level filtered, then scaled up to start the next */
+    u32 vw[OF_LEVELS], vh[OF_LEVELS];
+    vw[0] = (g.w + 7) / 8, vh[0] = (g.h + 7) / 8;
+    for (int l = 1; l < OF_LEVELS; l++) vw[l] = (vw[l - 1] + 1) / 2, vh[l] = (vh[l - 1] + 1) / 2;
+    for (int level = OF_LEVELS - 1; level >= 0; level--) {
+        int va = (odd != (level & 1)) ? 1 : 0, vb = !va;
+        u32 lw = g.w >> level > 0 ? g.w >> level : 1, lh = g.h >> level > 0 ? g.h >> level : 1;
+        k.level = (u32)level;
+        if (!cbuf(&u[0], "cbOF", &k, sizeof k)) return 0;
+        u[1] = IMG("r_optical_flow_input", &g.of_in[a][level]);
+        u[2] = IMG("r_optical_flow_previous_input", &g.of_in[b][level]);
+        u[3] = IMG("rw_optical_flow", &g.of_vec[va][level]);
+        u[4] = IMG("rw_optical_flow_scd_output", &g.scd);
+        if (!run(cb, P_of_search, u, 5, ((lw + 3) / 4 * 16 + 63) / 64, (lh + 15) / 16, 1)) return 0;
+        u[1] = IMG("r_optical_flow_previous", &g.of_vec[va][level]);
+        u[2] = IMG("rw_optical_flow", level ? &g.of_vec[vb][level] : &g.flow);
+        if (!run(cb, P_of_filter, u, 3, (vw[level] + 15) / 16, (vh[level] + 3) / 4, 1)) return 0;
+        if (level > 0) {
+            u[1] = IMG("r_optical_flow_input", &g.of_in[a][level]);
+            u[2] = IMG("r_optical_flow_previous_input", &g.of_in[b][level]);
+            u[3] = IMG("r_optical_flow", &g.of_vec[vb][level]);
+            u[4] = IMG("rw_optical_flow_next_level", &g.of_vec[vb][level - 1]);
+            u[5] = IMG("rw_optical_flow_scd_output", &g.scd);
+            if (!run(cb, P_of_scale, u, 6, (vw[level - 1] + 3) / 4, (vh[level - 1] + 3) / 4, 1)) return 0;
+        }
+    }
+    g.of_index = (g.of_index + 1) % 16;
+    return 1;
+}
+
+/* ---- frame interpolation: ffxFrameInterpolationPrepare and ffxFrameInterpolationDispatch */
+typedef struct {
+    i32 render[2], display[2];
+    float display_rcp[2], near_z, far_z;
+    i32 target[2], mode, reset;
+    float device_to_view[4];
+    float delta_ms;
+    i32 hudless;
+    i32 distortion_size[2];
+    float flow_scale[2];
+    i32 flow_block;
+    u32 flags;
+    i32 max_render[2], flow_half, instances;
+    i32 rect_base[2], rect_size[2];
+    float bar[3];
+    u32 transfer;
+    float lum[2], tan_half_fov, pad;
+    float jitter[2], mv_scale[2];
+} FiConstants;
+typedef struct {
+    u32 mips, groups, offset[2];
+} PyramidConstants;
+_Static_assert(sizeof(FiConstants) == 176, "cbFI as std140 lays it out");
+
+static const char* const pyramid_names[PYRAMID_MIPS] = {
+    "rw_inpainting_pyramid0", "rw_inpainting_pyramid1", "rw_inpainting_pyramid2",  "rw_inpainting_pyramid3",
+    "rw_inpainting_pyramid4", "rw_inpainting_pyramid5", "rw_inpainting_pyramid6",  "rw_inpainting_pyramid7",
+    "rw_inpainting_pyramid8", "rw_inpainting_pyramid9", "rw_inpainting_pyramid10", "rw_inpainting_pyramid11",
+    "rw_inpainting_pyramid12"};
+/* a downsampling pass into the inpainting pyramid over w x h: the game vectors' or the output's */
+static int pyramid(VkCommandBuffer cb, int which, const Use* first, int nfirst, const Use* cb_fi, u32 w, u32 h) {
+    Use u[24];
+    u32 groups[2], offset[2], counts[2];
+    int n = 0;
+    spd_setup(w, h, -1, groups, offset, counts);
+    PyramidConstants pk = {counts[1], counts[0], {offset[0], offset[1]}};
+    for (int i = 0; i < nfirst; i++) u[n++] = first[i];
+    u[n++] = *cb_fi;
+    if (!cbuf(&u[n++], "cbInpaintingPyramid", &pk, sizeof pk)) return 0;
+    u[n++] = (Use){"rw_counters", VK_NULL_HANDLE, g.counters, 0, 256};
+    for (int m = 0; m < PYRAMID_MIPS; m++) u[n++] = VIEW(pyramid_names[m], g.pyramid.mip[m]);
+    return run(cb, which, u, n, groups[0], groups[1], 1);
+}
+static int fi_dispatch(VkCommandBuffer cb, VkImageView prev, VkImageView cur, VkImageView out, int reset) {
+    const float near_z = 0.1f, far_z = 1000.0f, fov = 1.0f;
+    float q = far_z / (near_z - far_z), aspect = (float)g.w / (float)g.h, cot = cosf(fov / 2) / sinf(fov / 2);
+    FiConstants k = {
+        .render = {(i32)g.w, (i32)g.h}, .display = {(i32)g.w, (i32)g.h},
+        .display_rcp = {1.0f / (float)g.w, 1.0f / (float)g.h}, .near_z = near_z, .far_z = far_z,
+        .target = {(i32)g.w, (i32)g.h}, .reset = reset,
+        /* setupDeviceDepthToViewSpaceDepthParams for a depth neither inverted nor infinite */
+        .device_to_view = {-q, q * near_z, aspect / cot, 1.0f / cot}, .delta_ms = 16.6f,
+        .distortion_size = {1, 1}, .flow_scale = {1.0f / (float)g.w, 1.0f / (float)g.h}, .flow_block = 8,
+        .max_render = {(i32)g.w, (i32)g.h}, .instances = 1, .rect_size = {(i32)g.w, (i32)g.h},
+        .tan_half_fov = tanf(atanf(tanf(fov / 2) * aspect)), .mv_scale = {1.0f / (float)g.w, 1.0f / (float)g.h}};
+    Use c, u[16];
+    u32 rx = (g.w + 7) / 8, ry = (g.h + 7) / 8;
+    if (!cbuf(&c, "cbFI", &k, sizeof k)) return 0;
+    /* prepare: the game's vectors (none) and depth (flat) dilated, the previous depth reconstructed */
+    clear_u(cb, &g.prev_depth, 0x3F800000u); /* 1.0, the far plane */
+    sync(cb);
+    u[0] = c;
+    u[1] = IMG("r_input_motion_vectors", &g.mvs);
+    u[2] = IMG("r_input_depth", &g.depth);
+    u[3] = IMG("rw_reconstructed_depth_previous_frame", &g.prev_depth);
+    u[4] = IMG("rw_dilated_motion_vectors", &g.dil_mvs);
+    u[5] = IMG("rw_dilated_depth", &g.dil_depth);
+    if (!run(cb, P_fi_dilate, u, 6, rx, ry, 1)) return 0;
+    /* dispatch */
+    Use counters = {"rw_counters", VK_NULL_HANDLE, g.counters, 0, 256};
+    u[1] = IMG("r_optical_flow_scd", &g.scd);
+    u[2] = IMG("rw_game_motion_vector_field_x", &g.game_x);
+    u[3] = IMG("rw_game_motion_vector_field_y", &g.game_y);
+    u[4] = IMG("rw_optical_flow_motion_vector_field_x", &g.flow_x);
+    u[5] = IMG("rw_optical_flow_motion_vector_field_y", &g.flow_y);
+    u[6] = IMG("rw_disocclusion_mask", &g.disocclusion);
+    u[7] = counters;
+    if (!run(cb, P_fi_setup, u, 8, rx, ry, 1)) return 0;
+    if (!reset) {
+        clear_u(cb, &g.interp_depth, 0x3F800000u);
+        sync(cb);
+        u[1] = IMG("r_dilated_motion_vectors", &g.dil_mvs);
+        u[2] = IMG("r_dilated_depth", &g.dil_depth);
+        u[3] = VIEW("r_current_interpolation_source", cur);
+        u[4] = IMG("r_input_distortion_field", &g.distortion);
+        u[5] = IMG("rw_reconstructed_depth_interpolated_frame", &g.interp_depth);
+        if (!run(cb, P_fi_previous_depth, u, 6, rx, ry, 1)) return 0;
+        u[3] = VIEW("r_previous_interpolation_source", prev);
+        u[5] = VIEW("r_current_interpolation_source", cur);
+        u[6] = IMG("rw_game_motion_vector_field_x", &g.game_x);
+        u[7] = IMG("rw_game_motion_vector_field_y", &g.game_y);
+        u[8] = IMG("r_input_distortion_field", &g.distortion);
+        if (!run(cb, P_fi_game_field, u, 9, rx, ry, 1)) return 0;
+        {
+            Use first[2] = {IMG("r_game_motion_vector_field_x", &g.game_x),
+                            IMG("r_game_motion_vector_field_y", &g.game_y)};
+            if (!pyramid(cb, P_fi_game_pyramid, first, 2, &c, g.w, g.h)) return 0;
+        }
+        u[1] = IMG("r_optical_flow", &g.flow);
+        u[2] = IMG("r_optical_flow_confidence", &g.dummy_uint); /* AMD's frame generation gives none either */
+        u[3] = IMG("r_dilated_depth", &g.dil_depth);
+        u[4] = VIEW("r_previous_interpolation_source", prev);
+        u[5] = VIEW("r_current_interpolation_source", cur);
+        u[6] = IMG("rw_optical_flow_motion_vector_field_x", &g.flow_x);
+        u[7] = IMG("rw_optical_flow_motion_vector_field_y", &g.flow_y);
+        if (!run(cb, P_fi_flow_field, u, 8, (u32)((float)g.w / 8.0f + 7) / 8, (u32)((float)g.h / 8.0f + 7) / 8, 1))
+            return 0;
+        u[1] = IMG("r_game_motion_vector_field_x", &g.game_x);
+        u[2] = IMG("r_game_motion_vector_field_y", &g.game_y);
+        u[3] = IMG("r_reconstructed_depth_previous_frame", &g.prev_depth);
+        u[4] = IMG("r_dilated_depth", &g.dil_depth);
+        u[5] = IMG("r_reconstructed_depth_interpolated_frame", &g.interp_depth);
+        u[6] = IMG("r_inpainting_pyramid", &g.pyramid);
+        u[7] = IMG("r_input_distortion_field", &g.distortion);
+        u[8] = IMG("rw_disocclusion_mask", &g.disocclusion);
+        if (!run(cb, P_fi_disocclusion, u, 9, rx, ry, 1)) return 0;
+    }
+    u32 dx = (g.w + 7) / 8, dy = (g.h + 7) / 8;
+    u[1] = IMG("r_game_motion_vector_field_x", &g.game_x);
+    u[2] = IMG("r_game_motion_vector_field_y", &g.game_y);
+    u[3] = IMG("r_optical_flow_motion_vector_field_x", &g.flow_x);
+    u[4] = IMG("r_optical_flow_motion_vector_field_y", &g.flow_y);
+    u[5] = VIEW("r_previous_interpolation_source", prev);
+    u[6] = VIEW("r_current_interpolation_source", cur);
+    u[7] = IMG("r_disocclusion_mask", &g.disocclusion);
+    u[8] = IMG("r_inpainting_pyramid", &g.pyramid);
+    u[9] = (Use){"r_counters", VK_NULL_HANDLE, g.counters, 0, 256};
+    u[10] = VIEW("rw_output", out);
+    if (!run(cb, P_fi_interpolate, u, 11, dx, dy, 1)) return 0;
+    {
+        Use first[1] = {VIEW("r_output", out)};
+        if (!pyramid(cb, P_fi_pyramid, first, 1, &c, g.w, g.h)) return 0;
+    }
+    u[1] = IMG("r_optical_flow_scd", &g.scd);
+    u[2] = IMG("r_inpainting_pyramid", &g.pyramid);
+    u[3] = VIEW("r_present_backbuffer", cur);
+    u[4] = VIEW("r_current_interpolation_source", cur);
+    u[5] = VIEW("rw_output", out);
+    return run(cb, P_fi_inpaint, u, 6, dx, dy, 1);
+}
+
+int vk_ffx_interpolate(VkCommandBuffer cb, Surf* prev, VkImageView prev_raw, Surf* cur, VkImageView cur_raw, Surf* out,
+                       VkImageView out_raw, int reset) {
+    u32 w = cur->sw, h = cur->sh;
+    if (!g_settings.amd_frame_generation || !setup()) return 0;
+    if (prev->sw != w || prev->sh != h || out->sw != w || out->sh != h || w < 16 || h < 16) return 0;
+    if (g.w != w || g.h != h) reset = 1;
+    if (!images(w, h)) {
+        if (!g.logged) LOG("vulkan: FSR 3 (AMD) unavailable: no memory for its images\n");
+        g.logged = 1;
+        g.w = g.h = 0;
+        return 0;
+    }
+    cb = vk_cmd(); /* images() may have waited out the buffer that was recording */
+    vk_surf_use(cb, prev, VK_IMAGE_LAYOUT_GENERAL, VK_PIPELINE_STAGE_2_COMPUTE_SHADER_BIT,
+                VK_ACCESS_2_SHADER_SAMPLED_READ_BIT | VK_ACCESS_2_SHADER_STORAGE_READ_BIT);
+    vk_surf_use(cb, cur, VK_IMAGE_LAYOUT_GENERAL, VK_PIPELINE_STAGE_2_COMPUTE_SHADER_BIT,
+                VK_ACCESS_2_SHADER_SAMPLED_READ_BIT | VK_ACCESS_2_SHADER_STORAGE_READ_BIT);
+    vk_surf_use(cb, out, VK_IMAGE_LAYOUT_GENERAL, VK_PIPELINE_STAGE_2_COMPUTE_SHADER_BIT,
+                VK_ACCESS_2_SHADER_STORAGE_WRITE_BIT | VK_ACCESS_2_SHADER_SAMPLED_READ_BIT);
+    /* the game's depth flat at the far plane, its motion vectors zero, the distortion field none */
+    clear_f(cb, &g.depth, 1.0f);
+    clear_f(cb, &g.mvs, 0.0f);
+    clear_f(cb, &g.distortion, 0.0f);
+    clear_u(cb, &g.dummy_uint, 0);
+    if (!g.counters_zeroed) { /* the frames since the last reset start at none: AMD's setup only adds to them */
+        VkBuffer zeros;
+        u64 off;
+        u8* p = vk_stage(256, 16, &zeros, &off);
+        if (!p) return 0;
+        memset(p, 0, 256);
+        VkBufferCopy copy = {off, 0, 256};
+        rec_CmdCopyBuffer(cb, zeros, g.counters, 1, &copy);
+        g.counters_zeroed = 1;
+    }
+    general(cb, &g.pyramid);
+    for (int i = 0; i < 2; i++)
+        for (int l = 0; l < OF_LEVELS; l++) general(cb, &g.of_vec[i][l]);
+    Img* rest[] = {&g.flow, &g.dil_depth, &g.dil_mvs, &g.game_x, &g.game_y, &g.flow_x, &g.flow_y, &g.disocclusion};
+    for (u32 i = 0; i < sizeof rest / sizeof *rest; i++) general(cb, rest[i]);
+    sync(cb);
+    /* A new history (the first pair, a hitch, a new size): AMD's optical flow sees the previous frame first, so this
+       pair is interpolated too, where AMD's reset would show the current frame again. A real scene cut is still its
+       scene change detection's to find, which makes the interpolation show the current frame */
+    if (reset && !of_dispatch(cb, prev_raw, 1)) {
+        vk_render_forget_state();
+        return 0;
+    }
+    if (!of_dispatch(cb, cur_raw, 0) || !fi_dispatch(cb, prev_raw, cur_raw, out_raw, 0)) {
+        vk_render_forget_state();
+        return 0;
+    }
+    vk_render_forget_state();
+    if (++g.made == 1 || g.made % 1800 == 0)
+        LOG("vulkan: FSR 3 (AMD FidelityFX optical flow and frame interpolation) made %llu frames, %ux%u\n",
+            (unsigned long long)g.made, w, h);
+    return 1;
+}
+
+void vk_ffx_destroy(void) {
+    Img* all[] = {&g.scd_hist,     &g.scd_prev, &g.scd_temp, &g.flow,   &g.scd,    &g.depth,        &g.mvs,
+                  &g.dil_depth,    &g.dil_mvs,  &g.prev_depth, &g.interp_depth, &g.game_x, &g.game_y, &g.flow_x,
+                  &g.flow_y,       &g.pyramid,  &g.disocclusion, &g.distortion, &g.dummy_uint};
+    if (g.ready) vk_finish();
+    for (int f = 0; f < 2; f++)
+        for (int l = 0; l < OF_LEVELS; l++) img_drop(&g.of_in[f][l]), img_drop(&g.of_vec[f][l]);
+    for (u32 i = 0; i < sizeof all / sizeof *all; i++) img_drop(all[i]);
+    for (int i = 0; i < PASS_COUNT; i++) {
+        if (g.pass[i].pipe) vkDestroyPipeline(g_vk.dev, g.pass[i].pipe, NULL);
+        if (g.pass[i].layout) vkDestroyPipelineLayout(g_vk.dev, g.pass[i].layout, NULL);
+        if (g.pass[i].dsl) vkDestroyDescriptorSetLayout(g_vk.dev, g.pass[i].dsl, NULL);
+    }
+    for (int i = 0; i < VK_FRAMES; i++)
+        if (g.pool[i]) vkDestroyDescriptorPool(g_vk.dev, g.pool[i], NULL);
+    if (g.linear) vkDestroySampler(g_vk.dev, g.linear, NULL);
+    if (g.counters) vmaDestroyBuffer(g_vk.vma, g.counters, g.counters_mem);
+    memset(&g, 0, sizeof g);
+}
