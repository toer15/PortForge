+/* PortForge true resolution. Which targets a scale applies to is decided by the guest size alone, never the format,
+   so a color target and the depth target drawn with it (the same size) always agree: color scaled over native depth
+   corrupted BOTW. Following Ryujinx's UpscaleSafeMode (MIT): a square target (a shadow map, a cube face, a lookup
+   table, a texture atlas), a tiny one, or one far from a screen's shape holds data more often than a picture and
+   stays native. A scale below 1 intentionally trades screen detail for fewer pixels; the user can disable true
+   resolution if a game renders incorrectly. */
+int vk_rt_size_scales(u32 w, u32 h, u32 layers) {
+    if (g_vk_scale == 1.0f) return 0;
+    if (!g_vk_scale_selective) return 1; /* the experimental whole-scale path (render_scale_safety=0) */
+    if (layers != 1 || w < 64 || h < 64 || w == h) return 0;
+    /* landscape, from 5:4 to a little past 21:9: a 16:9 picture, a 4:3 one, or a half/quarter-size pass of either */
+    if ((u64)w * 4 < (u64)h * 5 || (u64)w * 10 > (u64)h * 26) return 0;
+    return 1;
+}
+float vk_surf_scale(const Surf* s) { return s && (s->sw != s->w || s->sh != s->h) ? g_vk_scale : 1.0f; }
+u32 vk_surf_sc(const Surf* s, u32 v) {
+    float k = vk_surf_scale(s);
+    u32 r;
+    if (k == 1.0f) return v;
+    r = (u32)((float)v * k + 0.5f);
     return r ? r : 1;
