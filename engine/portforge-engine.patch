+    printf("monitor ready\n");
+    for (;;) {
+        SDL_Event e;
+        int i;
+        while (SDL_PollEvent(&e)) {
+            if (e.type == SDL_EVENT_GAMEPAD_ADDED) {
+                for (i = 0; i < SNX_GAMEPADS && pads[i] && SDL_GetGamepadID(pads[i]) != e.gdevice.which; i++) {}
+                if (i < SNX_GAMEPADS && !pads[i] && (pads[i] = SDL_OpenGamepad(e.gdevice.which)) != NULL) {
+                    enable_motion(pads[i]);
+                    last[i][0] = 0;
+                    printf("pad %d connect %s %s\n", i, SDL_GetGamepadStringForType(SDL_GetGamepadType(pads[i])),
+                           SDL_GetGamepadName(pads[i]) ? SDL_GetGamepadName(pads[i]) : "Gamepad");
+                }
+            } else if (e.type == SDL_EVENT_GAMEPAD_REMOVED) {
+                for (i = 0; i < SNX_GAMEPADS; i++)
+                    if (pads[i] && SDL_GetGamepadID(pads[i]) == e.gdevice.which) {
+                        SDL_CloseGamepad(pads[i]);
+                        pads[i] = NULL;
+                        printf("pad %d disconnect\n", i);
+                    }
+            }
+        }
+        for (i = 0; i < SNX_GAMEPADS; i++) {
+            char line[256], m[3][64];
+            unsigned buttons = 0;
+            int b;
+            if (!pads[i]) continue;
+            for (b = 0; b < SDL_GAMEPAD_BUTTON_COUNT && b < 32; b++)
+                if (SDL_GetGamepadButton(pads[i], (SDL_GamepadButton)b)) buttons |= 1u << b;
+            monitor_sensor(pads[i], SDL_SENSOR_ACCEL, SDL_SENSOR_GYRO, m[0], sizeof m[0]);
+            monitor_sensor(pads[i], SDL_SENSOR_ACCEL_L, SDL_SENSOR_GYRO_L, m[1], sizeof m[1]);
+            monitor_sensor(pads[i], SDL_SENSOR_ACCEL_R, SDL_SENSOR_GYRO_R, m[2], sizeof m[2]);
+            snprintf(line, sizeof line, "state %d %x %d %d %d %d %d %d%s%s%s", i, buttons,
+                     SDL_GetGamepadAxis(pads[i], SDL_GAMEPAD_AXIS_LEFTX), SDL_GetGamepadAxis(pads[i], SDL_GAMEPAD_AXIS_LEFTY),
+                     SDL_GetGamepadAxis(pads[i], SDL_GAMEPAD_AXIS_RIGHTX), SDL_GetGamepadAxis(pads[i], SDL_GAMEPAD_AXIS_RIGHTY),
+                     SDL_GetGamepadAxis(pads[i], SDL_GAMEPAD_AXIS_LEFT_TRIGGER),
+                     SDL_GetGamepadAxis(pads[i], SDL_GAMEPAD_AXIS_RIGHT_TRIGGER), m[0], m[1], m[2]);
+            /* motion always changes; a still pad without it is repeated twice a second so the reader knows it lives */
+            if (strcmp(line, last[i]) || ++quiet[i] >= 50) {
+                puts(line);
+                snprintf(last[i], sizeof last[i], "%s", line);
+                quiet[i] = 0;
+            }
+        }
+        if (fflush(stdout) || ferror(stdout)) break; /* the reader is gone */
+        SDL_Delay(10);
+    }
+    for (int i = 0; i < SNX_GAMEPADS; i++)
+        if (pads[i]) SDL_CloseGamepad(pads[i]);
+    SDL_Quit();
+    return 0;
+}
