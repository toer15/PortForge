@@ -0,0 +1,29 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#include "nx/gpu/vk/render_scale.h"
+#include <assert.h>
+#include <stdio.h>
+#include <math.h>
+int main(void) {
+    const float requests[] = {0.25f, 0.5f, 0.75f, 1.0f, 1.5f, 2.0f, 4.0f};
+    for (unsigned i = 0; i < sizeof requests / sizeof *requests; i++) {
+        assert(pf_render_scale(requests[i], 1) == 1.0f);
+        assert(pf_render_scale(requests[i], 0) == requests[i]);
+    }
+    assert(pf_render_scale(0, 0) == 1.0f);
+    assert(pf_render_scale(NAN, 0) == 1.0f);
+    assert(pf_render_scale(INFINITY, 0) == 1.0f);
+    assert(pf_render_scale(100, 0) == 1.0f);
+    assert(pf_display_height("auto") == 0);
+    assert(pf_display_height("720") == 720);
+    assert(pf_display_height("1080") == 1080);
+    assert(pf_display_height("1440") == 1440);
+    assert(pf_display_height("2160") == 2160);
+    assert(pf_display_height("900") == 0);
+    assert(pf_display_width(1080) == 1920);
+    assert(pf_display_width(2160) == 3840);
+    assert(pf_display_scale(1440, 720) == 2.0f);
+    assert(pf_display_scale(1080, 1080) == 1.0f);
+    assert(pf_display_scale(0, 720) == 1.0f);
+    puts("PASS graphics protection: native intermediates; display_resolution height/scale helpers; invalid values safe");
+    return 0;
+}
