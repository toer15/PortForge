+    float h = w * 0.55f, grip = h * 0.8f, stick = h * 0.28f, button = h * 0.13f;
+    disc(l, x, y + h - grip * 0.9f, grip, grip, faded(body, a));
+    disc(l, x + w - grip, y + h - grip * 0.9f, grip, grip, faded(body, a));
+    ui_fill(l, x + grip * 0.35f, y + h * 0.15f, w - grip * 0.7f, h * 0.62f, faded(body, a));
+    disc(l, x + w * 0.22f, y + h * 0.22f, stick, stick, faded(parts, a));
+    disc(l, x + w * 0.56f, y + h * 0.42f, stick, stick, faded(parts, a));
+    for (int b = 0; b < 4; ++b) /* the diamond of face buttons */
+        disc(l, x + w * 0.74f + (b == 1 ? button : b == 3 ? -button : 0), y + h * 0.2f + (b == 0 ? -button : b == 2 ? button : 0),
+             button, button, faded(parts, a));
+}
+static float ease_out_back(float t) {
+    const float c1 = 1.70158f, c3 = c1 + 1;
+    float u = t - 1;
+    return 1 + c3 * u * u * u + c1 * u * u;
+}
+void overlay_toasts_draw(SnxUiList* l, int sw, int sh) {
+    int px, py, s, i, stack = 0;
+    float cw, ch, w, h;
+    u64 now = plat_ns() / 1000000u;
+    overlay_place(sw, sh, &px, &py, &s);
+    cw = 8.0f * (float)s;
+    ch = 16.0f * (float)s;
+    w = cw * 40;
+    h = ch * 3.2f;
+    for (i = 0; i < TOASTS; ++i) {
+        float t, a, pop, x, y, glyph;
+        char line[64];
+        int room;
+        if (!g_toasts[i].at_ms || now < g_toasts[i].at_ms) continue;
+        t = (float)(now - g_toasts[i].at_ms);
+        if (t >= TOAST_SHOW_MS + TOAST_OUT_MS) {
+            g_toasts[i].at_ms = 0;
+            continue;
+        }
+        /* in: it pops (overshoots and settles) and slides from the right; out: it fades and slides back */
+        pop = t < TOAST_IN_MS ? ease_out_back(t / TOAST_IN_MS) : 1;
+        a = t < TOAST_IN_MS ? t / TOAST_IN_MS : t > TOAST_SHOW_MS ? 1 - (t - TOAST_SHOW_MS) / TOAST_OUT_MS : 1;
+        x = (float)sw - w - 2 * cw + (1 - pop) * w * 0.35f + (t > TOAST_SHOW_MS ? (1 - a) * w * 0.3f : 0);
+        y = 2 * ch + (float)stack * (h + ch * 0.5f);
+        ++stack;
+        ui_fill(l, x, y, w, h, faded(LIGHT, a));
+        ui_fill(l, x, y, 4.0f * (float)s, h, faded(g_toasts[i].joined ? ACCENT : SOFT, a));
+        /* the controller grows in with the card's pop, from its middle */
+        glyph = h * 0.95f * (0.6f + 0.4f * pop);
+        controller_glyph(l, x + cw * 1.5f + (h * 0.95f - glyph) / 2, y + (h - glyph * 0.55f) / 2, glyph,
+                         g_toasts[i].joined ? ACCENT : SOFT, LIGHT, a);
+        /* the player and how the controller is connected on the first line, its name cut to the card's width under */
+        snprintf(line, sizeof line, "PLAYER %d %s", g_toasts[i].player, g_toasts[i].joined ? "JOINED" : "LEFT");
+        ui_text(l, x + cw * 2 + h, y + ch * 0.45f, s, line, faded(INK, a));
+        if (g_toasts[i].wireless >= 0) {
+            const char* how = g_toasts[i].wireless ? "BLUETOOTH" : "USB";
+            ui_text(l, x + w - cw * (float)(strlen(how) + 1), y + ch * 0.45f, s, how, faded(SOFT, a));
+        }
+        room = (int)((w - cw * 3 - h) / cw);
+        if ((int)strlen(g_toasts[i].name) <= room) snprintf(line, sizeof line, "%s", g_toasts[i].name);
+        else snprintf(line, sizeof line, "%.*s...", room - 3, g_toasts[i].name);
+        ui_text(l, x + cw * 2 + h, y + ch * 1.6f, s, line, faded(SOFT, a));
+    }
+}
+
+/* ---- the preparing screen (PortForge) */
+static int g_prep_on;
+static u32 g_prep_done, g_prep_total;
+static u64 g_prep_since;
+void overlay_prepare(int on, u32 done, u32 total) {
+    if (on && !__atomic_load_n(&g_prep_on, __ATOMIC_ACQUIRE)) {
+        __atomic_store_n(&g_prep_since, plat_ns(), __ATOMIC_RELAXED);
+    }
+    __atomic_store_n(&g_prep_done, done, __ATOMIC_RELAXED);
+    __atomic_store_n(&g_prep_total, total, __ATOMIC_RELAXED);
+    __atomic_store_n(&g_prep_on, on, __ATOMIC_RELEASE);
+}
+int overlay_preparing(void) { return __atomic_load_n(&g_prep_on, __ATOMIC_ACQUIRE); }
+/* the game's key art blurred over the whole window, its poster in an accent frame, and beside it the game's name, what
+   is being made and a bar of how much is done; a moving bar while the file is still read */
+static void prepare_draw(SnxUiList* l, int sw, int sh) {
+    int px, py, s, poster = ui_has_poster();
+    u32 done = __atomic_load_n(&g_prep_done, __ATOMIC_RELAXED), total = __atomic_load_n(&g_prep_total, __ATOMIC_RELAXED);
+    double t = (double)(plat_ns() - __atomic_load_n(&g_prep_since, __ATOMIC_RELAXED)) / 1e9;
+    const char* game = g_mod && g_mod->title && g_mod->title[0] ? g_mod->title : g_exename;
+    char big[64], line[96];
+    float cw, ch, side, gap, textw, x0, y0, tx, ty, bw, bh, by;
+    size_t n, fit, i;
+    overlay_place(sw, sh, &px, &py, &s);
+    cw = 8.0f * (float)s;
+    ch = 16.0f * (float)s;
+    if (poster) {
+        ui_backdrop(l, 0, 0, (float)sw, (float)sh);
+        for (int band = 0, top = 0; band < 24; ++band) {
+            int next = sh * (band + 1) / 24;
+            ui_fill(l, 0, (float)top, (float)sw, (float)(next - top), (u32)(0x78 + band * 4) << 24);
+            top = next;
+        }
+    } else
+        ui_fill(l, 0, 0, (float)sw, (float)sh, LIGHT);
+    side = poster ? (float)sh * 0.34f : 0;
+    gap = poster ? 3 * cw : 0;
+    textw = 48 * cw;
+    if (side + gap + textw > (float)sw - 2 * cw) { /* a narrow window: the text keeps what is left */
+        textw = (float)sw - 2 * cw - side - gap;
+        if (textw < 24 * cw) side = gap = 0, textw = (float)sw - 2 * cw;
+    }
+    x0 = ((float)sw - side - gap - textw) / 2;
+    y0 = ((float)sh - (side > 12 * ch ? side : 12 * ch)) / 2;
+    if (side) {
+        ui_fill(l, x0 - (float)s, y0 - (float)s, side + 2 * (float)s, side + 2 * (float)s, ACCENT);
+        ui_poster(l, x0, y0, side, side, 0xFF);
+    }
+    tx = x0 + side + gap;
+    ty = y0 + (side > 12 * ch ? (side - 12 * ch) / 2 : 0);
+    ui_text(l, tx, ty, s, "PREPARING", ACCENT);
+    /* the name in capitals at twice the size, cut to the column */
+    fit = (size_t)(textw / (2 * cw));
+    for (n = 0, i = 0; game[i] && n < fit && n + 1 < sizeof big; ++i)
+        big[n++] = (char)(game[i] >= 'a' && game[i] <= 'z' ? game[i] - 'a' + 'A' : game[i]);
+    big[n] = 0;
+    ui_text(l, tx, ty + 1.4f * ch, 2 * s, big, INK);
+    ui_text(l, tx, ty + 4.2f * ch, s, "Building shaders so the game plays smoothly", SOFT);
+    bw = textw;
+    bh = ch * 0.5f;
+    by = ty + 9.0f * ch; /* room above it for the runner */
+    ui_fill(l, tx, by, bw, bh, faded(INK, 0.3f));
+    float front; /* where the bar's fill ends, which the runner leads */
+    if (total) {
+        front = bw * (float)done / (float)total;
+        ui_fill(l, tx, by, front, bh, ACCENT);
+    } else { /* not known yet: a quarter of the bar sweeping across */
+        float seg = bw / 4, at = (float)fmod(t * 0.7, 1.0) * (bw + seg) - seg;
+        float from = at < 0 ? 0 : at, to = at + seg > bw ? bw : at + seg;
+        if (to > from) ui_fill(l, tx + from, by, to - from, bh, ACCENT);
+        front = to;
+    }
+    if (poster) {
+        /* the game's character running at the fill's front: a stride every 0.4 s, up and down with it, a puff of dust
+           behind each footfall drifting back and fading */
+        float rs = 3.2f * ch, phase = (float)fmod(t / 0.4, 1.0), hop = fabsf(sinf(phase * 3.14159265f)) * rs * 0.3f;
+        float rx = tx + front - rs / 2, top = by - (float)s - rs - hop;
+        if (rx < tx - rs / 2) rx = tx - rs / 2;
+        for (int k = 3; k >= 0; --k) {
+            double born = (floor(t / 0.2) - k) * 0.2, age = t - born;
+            float size = rs * 0.16f * (1 + (float)age * 2.5f);
+            if (age < 0 || age > 0.8 || born < 0) continue;
+            disc(l, rx + rs * 0.2f - (float)age * rs * 0.9f - size / 2, by - (float)age * rs * 0.3f - size / 2, size, size,
+                 faded(SNX_OVERLAY_RGBA(0xE6E1D7u, 0xFFu), 0.55f * (1 - (float)age / 0.8f)));
+        }
+        ui_runner(l, rx, top, rs, rs, 0xFF); /* its rings are in the badge */
+    }
+    if (total)
+        snprintf(line, sizeof line, "%u of %u shaders   %u%%", done, total, (u32)((u64)done * 100 / total));
+    else
+        snprintf(line, sizeof line, "Reading the shaders of earlier runs%.*s", (int)(t * 3) % 4, "...");
+    ui_text(l, tx, by + bh + 0.7f * ch, s, line, INK);
+    ui_text(l, tx, by + bh + 2.3f * ch, s, "Only while shaders need building", SOFT);
+}
