+static void test_narrow_exclusive(void) {
+    /* LDXR X9,[X0]; ADD W10,W9,#1; STXR W11,W10,[X0]; MOV W0,W11; RET.
+       Returning the status instead of retrying makes the historical infinite loop a bounded failure. */
+    static const u32 words[] = {0xC85F7C09, 0x1100052A, 0x880B7C0A, 0x2A0B03E0, 0xD65F03C0};
+    const u64 data = 0x31000, initial = 0x1122334400000007ull;
+    CPU c;
+    put(0x6800, words, sizeof words / sizeof *words);
+    service = start(0, 1);
+    CHECK(service != NULL);
+    if (!service) return;
+    snx_st_le64(memory + data, initial);
+    cpu_init(&c, 0xF000);
+    c.x[0] = data;
+    run(&c, 0x6800);
