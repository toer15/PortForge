diff --git a/src/nx/gpu/vk/render_scale.h b/src/nx/gpu/vk/render_scale.h
new file mode 100644
index 00000000..a781c01e
--- /dev/null
+++ b/src/nx/gpu/vk/render_scale.h
@@ -0,0 +1,89 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#ifndef PF_RENDER_SCALE_H
+#define PF_RENDER_SCALE_H
+#include <string.h>
+/* Render targets can hold game data, not just pictures. With graphics protection on, resolution= stays at 1: it
+   scaled every target, data ones too. Do not scale presentable color targets alone: depth stayed native and that
+   corrupted BOTW. True resolution (pf_true_scale) scales screen-shaped targets of every format together instead,
+   with texel fetches mapped in the shaders. Presentation upscaling (FSR) is separate. */
+static inline float pf_render_scale(float requested, int protect_graphics) {
+    if (protect_graphics || !(requested >= 0.25f && requested <= 4.0f)) return 1.0f;
+    return requested;
+}
+/* 720 / 1080 / 1440 / 2160 from display_resolution, or 0 for auto / unknown. */
+static inline int pf_display_height(const char* display_resolution) {
+    if (!display_resolution || !display_resolution[0]) return 0;
+    while (*display_resolution == ' ' || *display_resolution == '\t') display_resolution++;
+    if (!strcmp(display_resolution, "auto")) return 0;
+    if (!strcmp(display_resolution, "720")) return 720;
+    if (!strcmp(display_resolution, "1080")) return 1080;
+    if (!strcmp(display_resolution, "1440")) return 1440;
+    if (!strcmp(display_resolution, "2160")) return 2160;
+    return 0;
+}
+/* 16:9 width for a chosen output height. */
+static inline int pf_display_width(int height) { return height > 0 ? height * 16 / 9 : 0; }
+/* Scale from guest present / layout height toward the chosen output. Clamped to the engine's 0.25..4 range. */
+static inline float pf_display_scale(int display_h, int source_h) {
+    float s;
+    if (display_h <= 0 || source_h <= 0) return 1.0f;
+    s = (float)display_h / (float)source_h;
+    if (s < 0.25f) s = 0.25f;
+    if (s > 4.0f) s = 4.0f;
+    return s;
+}
+/* PortForge true resolution: scale screen-shaped targets toward a chosen display height, relative to the game's
+   typical output of 1080 lines in TV mode and 720 handheld. This can scale up or down; data-shaped targets stay
+   native in vk_rt_size_scales, and the window size remains independent of this render-target scale. */
+static inline float pf_true_scale(int display_h, int docked, int enabled) {
+    int own = docked ? 1080 : 720;
+    if (!enabled || display_h <= 0) return 1.0f;
+    return pf_display_scale(display_h, own);
+}
+/* The game's own output height: the one a run of it recorded (PfOutput below), else 1080 in TV mode and 720 handheld.
+   Many games draw fewer lines than that (900 docked is common), so the recorded height is what makes 1440 and 2160
+   exact rather than 1200 and 1800. */
+static inline int pf_true_own_height(int docked, int recorded) {
+    if (recorded >= 360 && recorded <= 2160) return recorded;
+    return docked ? 1080 : 720;
+}
+static inline float pf_true_scale_own(int display_h, int own_h, int enabled) {
+    if (!enabled || display_h <= 0 || own_h <= 0) return 1.0f;
+    return pf_display_scale(display_h, own_h);
+}
+/* The heights of the game's shown frames (guest pixels, the crop vi shows), counted to find its own output height. */
+enum { PF_OUTPUT_HEIGHTS = 8 };
+typedef struct {
+    unsigned h[PF_OUTPUT_HEIGHTS];
+    unsigned long long n[PF_OUTPUT_HEIGHTS], total;
+} PfOutput;
+/* 1 when the frame was counted */
+static inline int pf_output_note(PfOutput* o, unsigned w, unsigned h) {
+    int i, low = 0;
+    /* screen-shaped only: 4:3 to 21:9, at least 360 lines. A movie's or a menu's odd buffer says nothing */
+    if (h < 360 || h > 2160 || (unsigned long long)w * 3 < (unsigned long long)h * 4 ||
+        (unsigned long long)w * 9 > (unsigned long long)h * 21)
+        return 0;
+    o->total++;
+    for (i = 0; i < PF_OUTPUT_HEIGHTS; i++)
+        if (o->h[i] == h) {
+            o->n[i]++;
+            return 1;
+        }
+    for (i = 1; i < PF_OUTPUT_HEIGHTS; i++)
+        if (o->n[i] < o->n[low]) low = i;
+    o->h[low] = h;
+    o->n[low] = 1;
+    return 1;
+}
+/* The game's full output height: the tallest height shown in at least an eighth of the frames, so a dynamic-resolution
+   game's top height wins over its dips and a title screen's few frames don't count. 0 before enough frames. */
+static inline int pf_output_height(const PfOutput* o, unsigned long long min_frames) {
+    unsigned best = 0;
+    int i;
+    if (o->total < min_frames) return 0;
+    for (i = 0; i < PF_OUTPUT_HEIGHTS; i++)
+        if (o->n[i] * 8 >= o->total && o->h[i] > best) best = o->h[i];
+    return (int)best;
+}
+#endif
