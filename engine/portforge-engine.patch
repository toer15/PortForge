diff --git a/tests/render_scale.c b/tests/render_scale.c
new file mode 100644
index 00000000..e6859b79
--- /dev/null
+++ b/tests/render_scale.c
@@ -0,0 +1,55 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#include "nx/gpu/vk/render_scale.h"
+#include <assert.h>
+#include <stdio.h>
+#include <math.h>
+int main(void) {
+    const float requests[] = {0.25f, 0.5f, 0.75f, 1.0f, 1.5f, 2.0f, 4.0f};
+    for (unsigned i = 0; i < sizeof requests / sizeof *requests; i++) {
+        assert(pf_render_scale(requests[i], 1) == 1.0f);
+        assert(pf_render_scale(requests[i], 0) == requests[i]);
+    }
+    assert(pf_render_scale(0, 0) == 1.0f);
+    assert(pf_render_scale(NAN, 0) == 1.0f);
+    assert(pf_render_scale(INFINITY, 0) == 1.0f);
+    assert(pf_render_scale(100, 0) == 1.0f);
+    assert(pf_display_height("auto") == 0);
+    assert(pf_display_height("720") == 720);
+    assert(pf_display_height("1080") == 1080);
+    assert(pf_display_height("1440") == 1440);
+    assert(pf_display_height("2160") == 2160);
+    assert(pf_display_height("900") == 0);
+    assert(pf_display_width(1080) == 1920);
+    assert(pf_display_width(2160) == 3840);
+    assert(pf_display_scale(1440, 720) == 2.0f);
+    assert(pf_display_scale(1080, 1080) == 1.0f);
+    assert(pf_display_scale(0, 720) == 1.0f);
+    assert(pf_true_scale(720, 1, 1) > 0.666f && pf_true_scale(720, 1, 1) < 0.667f);
+    assert(pf_true_scale(1080, 1, 1) == 1.0f);
+    assert(pf_true_scale(1440, 1, 1) > 1.333f && pf_true_scale(1440, 1, 1) < 1.334f);
+    assert(pf_true_scale(2160, 1, 1) == 2.0f);
+    assert(pf_true_scale(1080, 0, 1) == 1.5f);
+    assert(pf_true_scale(720, 0, 1) == 1.0f);
+    assert(pf_true_scale(2160, 0, 1) == 3.0f);
+    assert(pf_true_scale(0, 1, 1) == 1.0f);
+    assert(pf_true_scale(720, 1, 0) == 1.0f);
+    /* a recorded output height: a 900-line game reaches 1440 and 2160 exactly */
+    assert(pf_true_own_height(1, 0) == 1080 && pf_true_own_height(0, 0) == 720);
+    assert(pf_true_own_height(1, 900) == 900 && pf_true_own_height(1, 100) == 1080);
+    assert(pf_true_scale_own(1440, 900, 1) == 1.6f);
+    assert(pf_true_scale_own(2160, 900, 1) == 2.4f);
+    assert(pf_true_scale_own(720, 900, 1) == 0.8f);
+    assert(pf_true_scale_own(1440, 900, 0) == 1.0f);
+    {
+        PfOutput o = {0};
+        unsigned i;
+        assert(!pf_output_note(&o, 512, 512) && !pf_output_note(&o, 640, 200)); /* square and tiny: not counted */
+        for (i = 0; i < 40; i++) pf_output_note(&o, 1920, 1080);            /* a title screen's few frames */
+        for (i = 0; i < 500; i++) pf_output_note(&o, 1600, 900);            /* the game's own height */
+        for (i = 0; i < 100; i++) pf_output_note(&o, 1408, 792);            /* dynamic-resolution dips */
+        assert(pf_output_height(&o, 600) == 900);
+        assert(pf_output_height(&o, 1000) == 0);
+    }
+    puts("PASS graphics protection: native data targets; true-resolution scales to 720p, 1080p, 1440p and 4K targets");
+    return 0;
+}
