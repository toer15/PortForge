new file mode 100644
index 0000000..130c79d
--- /dev/null
+++ b/tests/memory_layout.c
@@ -0,0 +1,25 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later
+   Copyright 2026 the ScarletNX contributors */
+/* The older SDK packs pointers into 36 bits. A stack in the 39-bit region is truncated before an IPC read. */
+#include "nx/memory/layout.h"
+#include <assert.h>
+#include <stdio.h>
+
+int main(void) {
+    MemLayout older = snx_memory_layout64(1), newer = snx_memory_layout64(3);
+    u64 mask = (1ull << 36) - 1, stack = older.stack + 0x100cf0;
+    assert(older.end == 1ull << 36);
+    assert(older.stack >= older.base && older.stack + older.stack_size <= 0x80000000ull);
+    assert(older.kern >= older.base && older.kern_end <= 0x80000000ull);
+    assert(older.alias == 0x80000000ull && older.alias_size == 6ull << 30);
+    assert(older.heap == older.alias + older.alias_size && older.heap_size == 8ull << 30);
+    assert(older.heap + older.heap_size <= older.end);
+    assert((stack & mask) == stack);
+    assert((older.kern & mask) == older.kern);
+    assert((newer.stack + 0x100cf0) != ((newer.stack + 0x100cf0) & mask));
+    assert(newer.end == AS_SIZE && newer.heap == 0x1100000000ull);
+    assert(newer.alias == 0x100000000ull && newer.alias_size == 64ull << 30);
+    assert(newer.stack == 0x1300000000ull && newer.kern == 0x1380000000ull);
+    puts("36-bit SDK stack/TLS pointers round-trip; 39-bit layout remains compatible");
+    return 0;
+}
