+    CHECK(stx(&c, memory, data, 2, 9) == 0 && !c.excl_on);
+    CHECK(snx_ld_le64(memory + data) == 0x1122334400000009ull);
+    ldx(&c, memory, data, 2);
+    CHECK(stx(&c, memory, data, 3, 10) == 1); /* cannot widen beyond what was loaded */
+    ldx(&c, memory, data, 3);
+    snx_st_le32(memory + data, 10);
+    CHECK(stx(&c, memory, data, 2, 11) == 1); /* a competing write still fails */
+    c.excl_on = 1; c.excl_size = 0x12; c.excl_addr = data;
+    CHECK(stx(&c, memory, data, 2, 12) == 1); /* a pair cannot become a single store */
+    puts("mixed-width exclusives: JIT and reference make progress without changing the upper word");
+}
