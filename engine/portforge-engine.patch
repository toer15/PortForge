diff --git a/src/nx/gpu/vk/shaders/fsr1.comp b/src/nx/gpu/vk/shaders/fsr1.comp
new file mode 100644
index 0000000..88e1851
--- /dev/null
+++ b/src/nx/gpu/vk/shaders/fsr1.comp
@@ -0,0 +1,60 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+/* AMD's FSR 1 EASU/RCAS, FP32 for Vulkan GPUs without FP16. No temporal inputs or generated frames. */
+#version 450
+#extension GL_GOOGLE_include_directive : require
+#define A_GPU 1
+#define A_GLSL 1
+#include "../fsr1/ffx_a.h"
+#ifdef FSR_SHARPEN
+#define FSR_RCAS_F 1
+#else
+#define FSR_EASU_F 1
+#endif
+#include "../fsr1/ffx_fsr1.h"
+layout(local_size_x=8,local_size_y=8) in;
+layout(set=0,binding=0) uniform sampler2D source;
+layout(set=0,binding=1,rgba16f) writeonly uniform image2D outputImage;
+layout(push_constant) uniform Params {
+    ivec4 crop;
+    uvec2 outputSize;
+    uint srgb;
+    float sharpness;
+} pc;
+#ifdef FSR_SHARPEN
+vec4 FsrRcasLoadF(ivec2 p) { return texelFetch(source,clamp(p,ivec2(0),ivec2(pc.outputSize)-1),0); }
+void FsrRcasInputF(inout float r,inout float g,inout float b) {}
+vec3 toLinear(vec3 v) { return mix(v/12.92,pow((v+0.055)/1.055,vec3(2.4)),greaterThan(v,vec3(0.04045))); }
+#else
+// Gather order matches GLSL textureGather. Clamp each tap to the crop, including nonzero offsets.
+vec4 gatherChannel(vec2 p,int c) {
+    ivec2 base=ivec2(floor(p*vec2(textureSize(source,0))-0.5));
+    ivec2 lo=pc.crop.xy, hi=lo+pc.crop.zw-1;
+    return vec4(texelFetch(source,clamp(base+ivec2(0,1),lo,hi),0)[c],
+                texelFetch(source,clamp(base+ivec2(1,1),lo,hi),0)[c],
+                texelFetch(source,clamp(base+ivec2(1,0),lo,hi),0)[c],
+                texelFetch(source,clamp(base,lo,hi),0)[c]);
+}
+vec4 FsrEasuRF(vec2 p) { return gatherChannel(p,0); }
+vec4 FsrEasuGF(vec2 p) { return gatherChannel(p,1); }
+vec4 FsrEasuBF(vec2 p) { return gatherChannel(p,2); }
+#endif
+void main() {
+    uvec2 p=gl_GlobalInvocationID.xy;
+    if(any(greaterThanEqual(p,pc.outputSize)))return;
+    vec3 color;
+#ifdef FSR_SHARPEN
+    uvec4 con; FsrRcasCon(con,pc.sharpness);
+    FsrRcasF(color.r,color.g,color.b,p,con);
+    color=clamp(color,0.0,1.0);
+    // The input view bypasses sRGB decode for FSR. Blitting to an sRGB swapchain re-encodes this result once.
+    if(pc.srgb!=0)color=toLinear(color);
+#else
+    uvec4 a,b,c,d;
+    vec2 size=vec2(textureSize(source,0));
+    FsrEasuConOffset(a,b,c,d,float(pc.crop.z),float(pc.crop.w),size.x,size.y,
+                    float(pc.outputSize.x),float(pc.outputSize.y),float(pc.crop.x),float(pc.crop.y));
+    FsrEasuF(color,p,a,b,c,d);
+    color=clamp(color,0.0,1.0);
+#endif
+    imageStore(outputImage,ivec2(p),vec4(color,1.0));
+}
