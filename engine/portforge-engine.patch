+int plat_cpu_cores(void) {
+    DWORD len = 0, at = 0;
+    int cores = 0;
+    u8* buf;
+    if (GetLogicalProcessorInformationEx(RelationProcessorCore, NULL, &len) || GetLastError() != ERROR_INSUFFICIENT_BUFFER)
+        return 0;
+    buf = (u8*)malloc(len);
+    if (!buf) return 0;
+    if (GetLogicalProcessorInformationEx(RelationProcessorCore, (SYSTEM_LOGICAL_PROCESSOR_INFORMATION_EX*)(void*)buf,
+                                         &len))
+        while (at < len) {
+            const SYSTEM_LOGICAL_PROCESSOR_INFORMATION_EX* e =
+                (const SYSTEM_LOGICAL_PROCESSOR_INFORMATION_EX*)(const void*)(buf + at);
+            if (!e->Size) break;
+            if (e->Relationship == RelationProcessorCore) cores++;
+            at += e->Size;
+        }
+    free(buf);
+    return cores;
+}
