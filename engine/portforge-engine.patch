 static PMutex g_pace_lock = PMUTEX_INIT;
 static u64 g_pace_last; /* when the frame before was due, 0 before the first */
+static int g_pace_fps;
+static u64 g_pace_period;
+
+/* PortForge speed lock: a game that asks for a swap interval counts its frames, so frames sooner than that interval
+   run the game itself faster. With the lock on, an FPS limit above the game's pace (or none) still waits for its pace;
+   a lower limit still lowers it. A game that asks for interval 0 times itself and is paced only by a set limit */
+u64 present_period(int fps, u32 interval, int lock) {
+    u64 game = interval ? 1000000000u / (u64)VI_REFRESH_HZ * interval : 0;
+    u64 cap = fps > 0 ? 1000000000u / (u64)fps : 0;
+    if (fps == SNX_FPS_GAME) return game;
+    if (lock && game > cap) return game;
+    return cap;
+}
 
 void present_pace(u32 interval) {
     int fps = __atomic_load_n(&g_opt_fps, __ATOMIC_RELAXED);
     u64 refresh, period, now, next;
-    if (!fps || (fps == SNX_FPS_GAME && !interval)) return;
-    refresh = 1000000000u / (fps == SNX_FPS_GAME ? (u64)VI_REFRESH_HZ : (u64)fps);
-    period = fps == SNX_FPS_GAME ? refresh * interval : refresh;
+    period = present_period(fps, interval, __atomic_load_n(&g_opt_speed_lock, __ATOMIC_RELAXED));
+    if (!period) {
+        pm_lock(&g_pace_lock);
+        g_pace_last = g_pace_period = 0;
+        g_pace_fps = fps;
+        pm_unlock(&g_pace_lock);
+        return;
+    }
+    refresh = 1000000000u / (fps > 0 ? (u64)fps : (u64)VI_REFRESH_HZ);
+    if (refresh > period) refresh = period;
+    if (fps != SNX_FPS_GAME && interval && (!fps || period != 1000000000u / (u64)fps) && fps != g_pace_fps)
+        LOG("speed lock: fps_limit %s held to the game's pace, %u frame(s) of %d Hz\n", fps ? "above it" : "off",
+            interval, VI_REFRESH_HZ);
     pm_lock(&g_pace_lock);
+    /* Switching limits or the game's interval must not inherit a future deadline from the old pace. */
+    if (fps != g_pace_fps || period != g_pace_period) g_pace_last = 0;
+    g_pace_fps = fps;
+    g_pace_period = period;
     now = plat_ns();
     next = g_pace_last + period;
     /* a schedule more than a refresh behind (a load, a pause) starts again from now: no burst to catch up */
