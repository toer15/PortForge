diff --git a/src/nx/runtime/platform/save_activity.c b/src/nx/runtime/platform/save_activity.c
new file mode 100644
index 0000000..f09695e
--- /dev/null
+++ b/src/nx/runtime/platform/save_activity.c
@@ -0,0 +1,29 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#include "nx/runtime/platform/save_activity.h"
+#include <stddef.h>
+static unsigned active;
+static int pending, pending_error;
+static uint64_t recent_until, error_until;
+void pf_save_begin(void) { __atomic_add_fetch(&active, 1, __ATOMIC_ACQ_REL); }
+void pf_save_end(uint64_t now, int success) {
+    /* Filesystem calls serialize on tree.lock. Error remains visible across subsequent successful chunks. */
+    __atomic_store_n(&recent_until, now + 1200000000ull, __ATOMIC_RELEASE);
+    if (!success) {
+        __atomic_store_n(&error_until, now + 6000000000ull, __ATOMIC_RELEASE);
+        __atomic_store_n(&pending_error, 1, __ATOMIC_RELEASE);
+    }
+    __atomic_store_n(&pending, 1, __ATOMIC_RELEASE);
+    __atomic_sub_fetch(&active, 1, __ATOMIC_ACQ_REL);
+}
+const char* pf_save_message(uint64_t now) {
+    if (__atomic_load_n(&pending_error, __ATOMIC_ACQUIRE) || now < __atomic_load_n(&error_until, __ATOMIC_ACQUIRE)) return "Save write failed";
+    if (__atomic_load_n(&pending, __ATOMIC_ACQUIRE) || __atomic_load_n(&active, __ATOMIC_ACQUIRE) || now < __atomic_load_n(&recent_until, __ATOMIC_ACQUIRE))
+        return "Saving...";
+    return NULL;
+}
+void pf_save_presented(uint64_t now) {
+    if (__atomic_exchange_n(&pending, 0, __ATOMIC_ACQ_REL))
+        __atomic_store_n(&recent_until, now + 1200000000ull, __ATOMIC_RELEASE);
+    if (__atomic_exchange_n(&pending_error, 0, __ATOMIC_ACQ_REL))
+        __atomic_store_n(&error_until, now + 6000000000ull, __ATOMIC_RELEASE);
+}
