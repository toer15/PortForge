diff --git a/src/nx/runtime/platform/frame_trace.c b/src/nx/runtime/platform/frame_trace.c
new file mode 100644
index 0000000..4f497ef
--- /dev/null
+++ b/src/nx/runtime/platform/frame_trace.c
@@ -0,0 +1,118 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#include "nx/runtime/platform/frame_trace.h"
+#include <stdlib.h>
+#include <string.h>
+
+static const char* const CAUSES[PF_PARTS + 1] = {"shader translation", "pipeline builds", "compute program builds",
+                                                  "render target creation", "texture uploads", "game file reads",
+                                                  "waiting for the GPU", "GPU finishes", "game code compiling",
+                                                  "presenting to the display", "game or unmeasured work"};
+static const char* const COLUMNS[PF_PARTS] = {"shaders_ms", "pipeline_wait_ms", "compute_build_ms", "render_target_ms",
+                                              "texture_upload_ms", "file_read_ms", "gpu_wait_ms", "gpu_finish_ms",
+                                              "jit_wait_ms", "present_ms"};
+static const char* const COUNTS[PF_COUNTS] = {"shaders", "pipelines", "render_targets", "uploads", "upload_kb",
+                                              "file_reads", "read_kb", "allocations", "compute_programs", "jit_waits"};
+
+const char* pf_trace_cause_name(int cause) { return cause >= 0 && cause <= PF_PARTS ? CAUSES[cause] : CAUSES[PF_PARTS]; }
+
+int pf_trace_cause(const unsigned long long part_ms[PF_PARTS], unsigned long long frame_ms) {
+    int best = PF_CAUSE_GAME, i;
+    unsigned long long most = 0;
+    for (i = 0; i < PF_PARTS; ++i)
+        if (part_ms[i] > most) {
+            most = part_ms[i];
+            best = i;
+        }
+    /* parts run on several threads and can overlap: one names the frame only when it is a real share of it */
+    return most >= 4 && most * 4 >= frame_ms ? best : PF_CAUSE_GAME;
+}
+
+static int compare_ms(const void* a, const void* b) {
+    float x = *(const float*)a, y = *(const float*)b;
+    return x < y ? -1 : x > y;
+}
+
+float pf_trace_typical(const PfTrace* t) {
+    float sorted[PF_TRACE_FRAMES];
+    if (!t->count) return 0;
+    memcpy(sorted, t->ms, sizeof sorted);
+    qsort(sorted, t->count == PF_TRACE_FRAMES ? PF_TRACE_FRAMES : t->count, sizeof *sorted, compare_ms);
+    /* before the ring fills its first slots hold the frames, in order from 0 */
+    return sorted[t->count / 2];
+}
+
+int pf_trace_is_hitch(const PfTrace* t, float frame_ms) {
+    if (t->count < 30) return frame_ms >= 50.0f;
+    return frame_ms >= 25.0f && frame_ms >= 2.0f * pf_trace_typical(t);
+}
+
+int pf_trace_add(PfTrace* t, float frame_ms, int cause) {
+    int hitch = pf_trace_is_hitch(t, frame_ms);
+    t->ms[t->at] = frame_ms;
+    t->cause[t->at] = (unsigned char)cause;
+    t->hitch[t->at] = (unsigned char)hitch;
+    t->at = (t->at + 1) % PF_TRACE_FRAMES;
+    if (t->count < PF_TRACE_FRAMES) t->count++;
+    t->frames++;
+    if (hitch) {
+        t->hitches++;
+        t->last_hitch_ms = frame_ms;
+        t->last_hitch_cause = cause;
+    }
+    return hitch;
+}
+
+void pf_trace_csv_header(FILE* f) {
+    int i;
+    fputs("frame,time_s,frame_ms,hitch,cause", f);
+    for (i = 0; i < PF_PARTS; ++i) fprintf(f, ",%s", COLUMNS[i]);
+    for (i = 0; i < PF_COUNTS; ++i) fprintf(f, ",%s", COUNTS[i]);
+    fputc('\n', f);
+}
+
+void pf_trace_csv_line(FILE* f, unsigned long long frame, double seconds, float frame_ms,
+                       const unsigned long long part_ms[PF_PARTS], const unsigned long long counts[PF_COUNTS], int cause,
+                       int hitch) {
+    int i;
+    fprintf(f, "%llu,%.3f,%.2f,%d,%s", frame, seconds, (double)frame_ms, hitch, pf_trace_cause_name(cause));
+    for (i = 0; i < PF_PARTS; ++i) fprintf(f, ",%llu", part_ms[i]);
+    for (i = 0; i < PF_COUNTS; ++i) fprintf(f, ",%llu", counts[i]);
+    fputc('\n', f);
+}
+
+#define RGBA(r, g, b, a) ((unsigned)(r) | (unsigned)(g) << 8 | (unsigned)(b) << 16 | (unsigned)(a) << 24)
+
+void pf_trace_draw(const PfTrace* t, SnxUiList* l, const int safe[4], int sh, int display_fps) {
+    const float range_ms = 100.0f;
+    int s = sh >= 1440 ? 2 : 1, i;
+    float bar = 2.0f * (float)s, height = 90.0f * (float)s, line = 16.0f * (float)s, pad = 4.0f * (float)s;
+    float x0 = (float)safe[0] + 12.0f, y0 = (float)safe[1] + 12.0f;
+    float w = bar * PF_TRACE_FRAMES + 2 * pad, h = height + 2 * line + 3 * pad, base = y0 + line + pad + height;
+    float typical = pf_trace_typical(t);
+    char text[96];
+    ui_fill(l, x0, y0, w, h, RGBA(16, 16, 16, 200));
+    if (display_fps >= 0)
+        snprintf(text, sizeof text, "FRAME TIME  %d FPS  typical %.1f ms  hitches %llu", display_fps, (double)typical,
+                 t->hitches);
+    else
+        snprintf(text, sizeof text, "FRAME TIME  typical %.1f ms  hitches %llu", (double)typical, t->hitches);
+    ui_text(l, x0 + pad, y0 + pad / 2, s, text, RGBA(255, 255, 255, 255));
+    /* the 60 and 30 FPS frame times */
+    ui_fill(l, x0 + pad, base - height * (16.7f / range_ms), bar * PF_TRACE_FRAMES, (float)s, RGBA(90, 90, 90, 255));
+    ui_fill(l, x0 + pad, base - height * (33.3f / range_ms), bar * PF_TRACE_FRAMES, (float)s, RGBA(90, 90, 90, 255));
+    for (i = 0; i < (int)t->count; ++i) {
+        unsigned k = (t->at + PF_TRACE_FRAMES - t->count + (unsigned)i) % PF_TRACE_FRAMES;
+        float ms = t->ms[k], bh = height * (ms > range_ms ? 1.0f : ms / range_ms);
+        unsigned color = t->hitch[k]                                ? RGBA(255, 48, 48, 255)
+                         : typical > 0 && ms > 1.5f * typical ? RGBA(255, 208, 32, 255)
+                                                              : RGBA(64, 208, 96, 255);
+        if (bh < 1) bh = 1;
+        ui_fill(l, x0 + pad + bar * (float)(i + PF_TRACE_FRAMES - (int)t->count), base - bh, bar, bh, color);
+    }
+    if (t->hitches)
+        snprintf(text, sizeof text, "last hitch %.0f ms: %s", (double)t->last_hitch_ms,
+                 pf_trace_cause_name(t->last_hitch_cause));
+    else
+        snprintf(text, sizeof text, "no hitches yet");
+    ui_text(l, x0 + pad, base + pad, s, text, RGBA(200, 200, 200, 255));
+}
diff --git a/src/nx/runtime/platform/frame_trace.h b/src/nx/runtime/platform/frame_trace.h
new file mode 100644
index 0000000..37ce839
--- /dev/null
+++ b/src/nx/runtime/platform/frame_trace.h
@@ -0,0 +1,53 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+/* The frame-time trace: every presented frame's time and what the engine spent it on, kept for the in-game graph and
+   written as CSV for the launcher. A frame's cause is the largest measured part when it explains a real share of the
+   frame; otherwise the time went to the game's own CPU work, the GPU thread or something not yet measured */
+#ifndef PF_FRAME_TRACE_H
+#define PF_FRAME_TRACE_H
+#include <stdio.h>
+#include "nx/runtime/platform/ui.h"
+
+enum {
+    PF_PART_SHADERS,   /* shader translation */
+    PF_PART_PIPELINES, /* waits for graphics pipelines */
+    PF_PART_COMPUTE,   /* compute program builds */
+    PF_PART_TARGETS,   /* render target creation */
+    PF_PART_TEXTURES,  /* texture uploads */
+    PF_PART_FILES,     /* game file reads */
+    PF_PART_GPU,       /* waits for the GPU's graphics or compute queue */
+    PF_PART_FINISH,    /* full GPU finishes */
+    PF_PART_JIT,       /* game code compiled while a thread waited */
+    PF_PART_PRESENT,   /* handing frames to the display, and making its swapchain */
+    PF_PARTS
+};
+#define PF_CAUSE_GAME   PF_PARTS /* none of the parts: the game's own work, or a wait not measured */
+#define PF_TRACE_FRAMES 240
+/* counts beside the times, for the CSV */
