--- /dev/null
+++ b/src/nx/gpu/vk/fg.c
@@ -0,0 +1,469 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+/* PortForge FSR 3 (from scratch, shaders/fg.comp): optical-flow frame generation inspired by AMD FSR 3 / AFMF
+   (luma pyramid, hierarchical SAD search, median filter, bidirectional disocclusion, HUD lock, hole inpaint).
+   Not the AMD FidelityFX SDK � Switch games do not give host motion vectors. When FSR 1 is also on (the Settings
+   "PortForge FSR 3" package), each real frame is upscaled once and the midpoint is warped from those images so
+   FSR never runs on an interpolated picture. Display only. Under vk_lock. */
+#include <string.h>
+#include "nx/gpu/vk/vk.h"
+#include "nx/gpu/vk/fg_spv.h"
+#include "nx/runtime/platform/log.h"
+
+enum { LEVELS = 3 };
+enum { P_LUMA, P_SEARCH, P_MEDIAN, P_INTERP, PASSES };
+/* FG_MAX_MIDS from nx/gpu/vk/vk.h (3 generated + 1 real => 4x display). */
+typedef struct {
+    Surf s;
+    VkImageView rgba8; /* the 32-bit image read and written as R8G8B8A8_UNORM: the passes see its bytes as they are */
+} Pic;
+static struct {
+    int failed, logged;
+    VkDescriptorSetLayout ds;
+    VkPipelineLayout layout;
+    VkPipeline pipe[PASSES];
+    VkSampler nearest, bilinear;
+    Pic hist[2], out, dummy8;
+    Pic mids[FG_MAX_MIDS];
+    Pic up[2], up_mids[FG_MAX_MIDS]; /* FSR'd history + generated frames at letterbox size */
+    int up_ready[2];   /* up[i] matches up_w x up_h for the current hist slot */
+    u32 up_w, up_h;
+    Surf lum[2][LEVELS]; /* each history image's luma at 1/4, 1/8 and 1/16 */
+    Surf vec[LEVELS], med[LEVELS]; /* the motion at each level, and its median: what the next level starts from */
+    Surf dummy, dummy_w; /* sampled, and written, where a pass has no image for a binding */
+    int cur, have_prev;
+    u32 w, h;
+    VkFormat fmt;
+    u64 made;
+} g_fg;
+
+/* images are replaced only when the game's picture changes size or format: after a full wait, so no frame in flight
+   still uses them or their views */
+static void drop(Surf* s) {
+    if (s->img) {
+        vk_finish();
+        for (int i = 0; i < s->nsv; i++) vkDestroyImageView(g_vk.dev, s->sv[i].v, NULL);
+        vk_defer_image(s->img, s->mem, s->att, VK_NULL_HANDLE);
+        vk_defer_bytes(s->bytes);
+    }
+    memset(s, 0, sizeof *s);
+}
+static void pic_drop(Pic* p) {
+    if (p->rgba8) {
+        vk_finish();
+        vkDestroyImageView(g_vk.dev, p->rgba8, NULL);
+    }
+    p->rgba8 = VK_NULL_HANDLE;
+    drop(&p->s);
+}
+static VkImageView view(VkImage img, VkFormat f) {
+    VkImageView v = VK_NULL_HANDLE;
+    VkImageViewCreateInfo vi = {.sType = VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO, .image = img,
+        .viewType = VK_IMAGE_VIEW_TYPE_2D, .format = f, .subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1}};
+    return VK_OK(vkCreateImageView(g_vk.dev, &vi, NULL, &v)) ? v : VK_NULL_HANDLE;
+}
+/* a scratch image: luma levels and motion */
+static int scratch(Surf* s, u32 w, u32 h) {
+    if (s->img && s->sw == w && s->sh == h) return 1;
+    drop(s);
+    VkImageCreateInfo ii = {.sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO, .imageType = VK_IMAGE_TYPE_2D,
+        .format = VK_FORMAT_R16G16B16A16_SFLOAT, .extent = {w, h, 1}, .mipLevels = 1, .arrayLayers = 1,
+        .samples = VK_SAMPLE_COUNT_1_BIT, .tiling = VK_IMAGE_TILING_OPTIMAL,
+        .usage = VK_IMAGE_USAGE_STORAGE_BIT | VK_IMAGE_USAGE_SAMPLED_BIT};
+    if (!vk_cache_image_create(&ii, &s->img, &s->mem, &s->bytes)) return 0;
+    if (!(s->att = view(s->img, ii.format))) { drop(s); return 0; }
+    s->f = (VkFmt){.vk = ii.format, .bpp = 8, .bw = 1, .bh = 1};
+    s->w = s->sw = w; s->h = s->sh = h; s->layers = s->levels = 1;
+    s->type = VK_IMAGE_VIEW_TYPE_2D;
+    return 1;
+}
+/* an image in the game image's format, presentable as it is, and writable through its R8G8B8A8 view */
+static int pic(Pic* p, VkFormat f, u32 w, u32 h) {
+    if (p->s.img && p->s.sw == w && p->s.sh == h && p->s.f.vk == f) return 1;
+    pic_drop(p);
+    VkImageCreateInfo ii = {.sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO,
+        .flags = VK_IMAGE_CREATE_MUTABLE_FORMAT_BIT | VK_IMAGE_CREATE_EXTENDED_USAGE_BIT,
+        .imageType = VK_IMAGE_TYPE_2D, .format = f, .extent = {w, h, 1}, .mipLevels = 1, .arrayLayers = 1,
+        .samples = VK_SAMPLE_COUNT_1_BIT, .tiling = VK_IMAGE_TILING_OPTIMAL,
+        .usage = VK_IMAGE_USAGE_STORAGE_BIT | VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT |
+                 VK_IMAGE_USAGE_TRANSFER_DST_BIT};
+    if (!vk_cache_image_create(&ii, &p->s.img, &p->s.mem, &p->s.bytes)) return 0;
+    VkImageViewUsageCreateInfo sampled = {.sType = VK_STRUCTURE_TYPE_IMAGE_VIEW_USAGE_CREATE_INFO,
+                                          .usage = VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT};
+    VkImageViewCreateInfo vi = {.sType = VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO, .pNext = &sampled,
+        .image = p->s.img, .viewType = VK_IMAGE_VIEW_TYPE_2D, .format = f,
+        .subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1}};
+    if (!VK_OK(vkCreateImageView(g_vk.dev, &vi, NULL, &p->s.att)) ||
+        !(p->rgba8 = view(p->s.img, VK_FORMAT_R8G8B8A8_UNORM))) {
+        pic_drop(p);
+        return 0;
+    }
+    p->s.f = (VkFmt){.vk = f, .bpp = 4, .bw = 1, .bh = 1};
+    p->s.w = p->s.sw = w; p->s.h = p->s.sh = h; p->s.layers = p->s.levels = 1;
+    p->s.type = VK_IMAGE_VIEW_TYPE_2D;
+    return 1;
+}
+
+static int setup(void) {
+    if (g_fg.failed) return 0;
+    if (g_fg.pipe[P_INTERP]) return 1;
+    g_fg.failed = 1; /* tried once a run */
+    VkDescriptorSetLayoutBinding b[5];
+    for (u32 i = 0; i < 5; i++)
+        b[i] = (VkDescriptorSetLayoutBinding){i, i < 3 ? VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER
+                                                       : VK_DESCRIPTOR_TYPE_STORAGE_IMAGE,
+                                              1, VK_SHADER_STAGE_COMPUTE_BIT, NULL};
+    VkDescriptorSetLayoutCreateInfo di = {.sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO,
+                                          .bindingCount = 5, .pBindings = b};
+    if (!VK_OK(vkCreateDescriptorSetLayout(g_vk.dev, &di, NULL, &g_fg.ds))) return 0;
+    VkPushConstantRange push = {VK_SHADER_STAGE_COMPUTE_BIT, 0, 32};
+    VkPipelineLayoutCreateInfo li = {.sType = VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO, .setLayoutCount = 1,
+                                     .pSetLayouts = &g_fg.ds, .pushConstantRangeCount = 1, .pPushConstantRanges = &push};
+    if (!VK_OK(vkCreatePipelineLayout(g_vk.dev, &li, NULL, &g_fg.layout))) return 0;
+    VkSamplerCreateInfo si = {.sType = VK_STRUCTURE_TYPE_SAMPLER_CREATE_INFO, .magFilter = VK_FILTER_NEAREST,
+        .minFilter = VK_FILTER_NEAREST, .mipmapMode = VK_SAMPLER_MIPMAP_MODE_NEAREST,
+        .addressModeU = VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE, .addressModeV = VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE,
+        .addressModeW = VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE};
+    if (!VK_OK(vkCreateSampler(g_vk.dev, &si, NULL, &g_fg.nearest))) return 0;
+    si.magFilter = si.minFilter = VK_FILTER_LINEAR;
+    if (!VK_OK(vkCreateSampler(g_vk.dev, &si, NULL, &g_fg.bilinear))) return 0;
+    const u32* spv[PASSES] = {[P_LUMA] = fg_luma_spv, [P_SEARCH] = fg_search_spv, [P_MEDIAN] = fg_median_spv,
+                              [P_INTERP] = fg_interp_spv};
+    u64 size[PASSES] = {[P_LUMA] = fg_luma_spv_size, [P_SEARCH] = fg_search_spv_size,
+                        [P_MEDIAN] = fg_median_spv_size, [P_INTERP] = fg_interp_spv_size};
+    for (int i = P_LUMA; i < PASSES; i++) {
+        VkShaderModule m = vk_module_spv(spv[i], size[i] / 4);
+        if (!m) return 0;
+        VkComputePipelineCreateInfo ci = {.sType = VK_STRUCTURE_TYPE_COMPUTE_PIPELINE_CREATE_INFO,
+            .stage = {.sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO, .stage = VK_SHADER_STAGE_COMPUTE_BIT,
+                      .module = m, .pName = "main"},
+            .layout = g_fg.layout};
+        int ok = VK_OK(vkCreateComputePipelines(g_vk.dev, vk_pipeline_cache(), 1, &ci, NULL, &g_fg.pipe[i]));
+        vkDestroyShaderModule(g_vk.dev, m, NULL);
+        if (!ok) return 0;
+    }
+    if (!scratch(&g_fg.dummy, 1, 1) || !scratch(&g_fg.dummy_w, 1, 1) || !pic(&g_fg.dummy8, VK_FORMAT_R8G8B8A8_UNORM, 1, 1))
+        return 0;
+    g_fg.failed = 0;
+    LOG("vulkan: frame generation ready: motion search and interpolation on the GPU\n");
+    return 1;
+}
+
+/* the 8-bit color formats the passes can read and write as R8G8B8A8 */
+static int usable(const Surf* src) {
+    VkFormat raw = vk_srgb_as(src->f.vk, 0);
+    return src->layers == 1 && !src->f.depth && !src->f.is_int && src->f.bw == 1 && src->f.bh == 1 &&
+           (raw == VK_FORMAT_R8G8B8A8_UNORM || raw == VK_FORMAT_B8G8R8A8_UNORM ||
+            raw == VK_FORMAT_A8B8G8R8_UNORM_PACK32);
+}
+
+/* one pass: srcA, srcB, srcC sampled (NULL: the dummy), into dst (a scratch image) or dst8 (a picture's view) */
+static int pass(VkCommandBuffer cb, int which, VkImageView a, VkImageView b, VkImageView c, VkSampler sa, Surf* dst,
+                 VkImageView dst8, u32 dw, u32 dh, const i32 extra[6]) {
+    VkDescriptorSet set = vk_desc_alloc(g_fg.ds);
+    if (!set) return 0;
+    VkDescriptorImageInfo ii[5] = {
+        {sa, a ? a : g_fg.dummy.att, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL},
+        {sa, b ? b : g_fg.dummy.att, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL},
+        {g_fg.bilinear, c ? c : g_fg.dummy.att, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL},
+        {VK_NULL_HANDLE, dst ? dst->att : g_fg.dummy_w.att, VK_IMAGE_LAYOUT_GENERAL},
+        {VK_NULL_HANDLE, dst8 ? dst8 : g_fg.dummy8.rgba8, VK_IMAGE_LAYOUT_GENERAL}};
+    VkWriteDescriptorSet w[5];
+    for (u32 i = 0; i < 5; i++)
+        w[i] = (VkWriteDescriptorSet){.sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET, .dstSet = set, .dstBinding = i,
+            .descriptorCount = 1,
+            .descriptorType = i < 3 ? VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER : VK_DESCRIPTOR_TYPE_STORAGE_IMAGE,
+            .pImageInfo = &ii[i]};
+    vkUpdateDescriptorSets(g_vk.dev, 5, w, 0, NULL);
+    struct { i32 dsize[2], asize[2], csize[2], radius, flags; } pc = {
+        {(i32)dw, (i32)dh}, {extra[0], extra[1]}, {extra[2], extra[3]}, extra[4], extra[5]};
+    rec_CmdBindPipeline(cb, VK_PIPELINE_BIND_POINT_COMPUTE, g_fg.pipe[which]);
+    rec_CmdBindDescriptorSets(cb, VK_PIPELINE_BIND_POINT_COMPUTE, g_fg.layout, 0, 1, &set, 0, NULL);
+    rec_CmdPushConstants(cb, g_fg.layout, VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof pc, &pc);
+    rec_CmdDispatch(cb, (dw + 7) / 8, (dh + 7) / 8, 1);
+    return 1;
+}
+static void reads(VkCommandBuffer cb, Surf* s) {
+    if (s && s->img)
+        vk_surf_use(cb, s, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL, VK_PIPELINE_STAGE_2_COMPUTE_SHADER_BIT,
+                    VK_ACCESS_2_SHADER_SAMPLED_READ_BIT);
+}
+static void writes(VkCommandBuffer cb, Surf* s) {
+    vk_surf_use(cb, s, VK_IMAGE_LAYOUT_GENERAL, VK_PIPELINE_STAGE_2_COMPUTE_SHADER_BIT,
+                VK_ACCESS_2_SHADER_STORAGE_WRITE_BIT);
+}
+static u32 half(u32 v) { return v > 1 ? (v + 1) / 2 : 1; }
+
+int vk_fg_capture(VkCommandBuffer cb, Surf* src, u32 x, u32 y, u32 w, u32 h) {
+    if (!src || !w || !h || x > src->sw || w > src->sw - x || y > src->sh || h > src->sh - y || !usable(src) ||
+        !setup()) {
+        g_fg.have_prev = 0;
+        return 0;
+    }
+    if (g_fg.w != w || g_fg.h != h || g_fg.fmt != src->f.vk) g_fg.have_prev = 0; /* nothing to blend across */
+    int next = g_fg.cur ^ 1;
+    Pic* p = &g_fg.hist[next];
+    if (!pic(p, src->f.vk, w, h)) goto unavailable;
+    u32 lw = half(w), lh = half(h);
+    for (int l = 0; l < LEVELS; l++) {
+        lw = half(lw); lh = half(lh);
+        if (!scratch(&g_fg.lum[next][l], lw, lh) || !scratch(&g_fg.vec[l], lw, lh) || !scratch(&g_fg.med[l], lw, lh))
+            goto unavailable;
+    }
+    if (!pic(&g_fg.out, src->f.vk, w, h)) goto unavailable;
+    vk_render_end();
+    /* Resizing scratch images can submit and retire the caller's command buffer. */
+    cb = vk_cmd();
+    reads(cb, &g_fg.dummy); /* the stand-ins in the layouts their descriptors name */
+    writes(cb, &g_fg.dummy_w);
+    writes(cb, &g_fg.dummy8.s);
+    vk_surf_touch(src);
+    vk_surf_use(cb, src, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, VK_PIPELINE_STAGE_2_COPY_BIT,
+                VK_ACCESS_2_TRANSFER_READ_BIT);
+    vk_surf_use(cb, &p->s, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, VK_PIPELINE_STAGE_2_COPY_BIT,
+                VK_ACCESS_2_TRANSFER_WRITE_BIT);
+    VkImageCopy copy = {.srcSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1}, .srcOffset = {(i32)x, (i32)y, 0},
+                        .dstSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1}, .extent = {w, h, 1}};
+    rec_CmdCopyImage(cb, src->img, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, p->s.img, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+                     1, &copy);
+    /* its luma pyramid, kept for the next frame's search too */
+    VkImageView from = p->rgba8;
+    Surf* from_s = &p->s;
+    u32 fw = w, fh = h;
+    for (int l = 0; l < LEVELS; l++) {
+        Surf* d = &g_fg.lum[next][l];
+        reads(cb, from_s);
+        writes(cb, d);
+        i32 extra[6] = {(i32)fw, (i32)fh, 1, 1, 0, l == 0};
+        if (!pass(cb, P_LUMA, from, NULL, NULL, g_fg.bilinear, d, NULL, d->sw, d->sh, extra)) goto unavailable;
+        from = d->att;
+        from_s = d;
+        fw = d->sw;
+        fh = d->sh;
+    }
+    vk_render_forget_state();
+    int pair = g_fg.have_prev;
+    g_fg.cur = next;
+    g_fg.have_prev = 1;
+    g_fg.w = w;
+    g_fg.h = h;
+    g_fg.fmt = src->f.vk;
+    return pair;
+unavailable:
+    vk_render_forget_state();
+    g_fg.have_prev = 0;
+    if (!g_fg.logged) LOG("vulkan: frame generation unavailable: no memory for its images\n");
+    g_fg.logged = 1;
+    return 0;
+}
+
+Surf* vk_fg_current(void) { return g_fg.have_prev ? &g_fg.hist[g_fg.cur].s : NULL; }
+Surf* vk_fg_previous(void) { return g_fg.have_prev ? &g_fg.hist[g_fg.cur ^ 1].s : NULL; }
+
+/* Motion field into med[], shared by native and FSR-present paths. 0 on failure.
+   Fine levels search radius 1 (a 5x5 SAD; a 3x3 window missed real block matches).
+   The coarsest level searches radius 4, which is 64 full-res pixels either way at
+   1/16, instead of radius 6. */
+static int fg_motion(VkCommandBuffer cb) {
+    static int cheap_logged;
+    int c, p;
+    if (!cheap_logged) {
+        cheap_logged = 1;
+        LOG("vulkan: frame generation: coarsest search radius is 4; wider radius skipped. Fine levels stay at radius 1\n");
+    }
+    c = g_fg.cur;
+    p = c ^ 1;
+    for (int l = LEVELS - 1; l >= 0; l--) {
+        Surf *la = &g_fg.lum[p][l], *lb = &g_fg.lum[c][l], *v = &g_fg.vec[l], *m = &g_fg.med[l];
+        Surf* coarser = l + 1 < LEVELS ? &g_fg.med[l + 1] : NULL;
+        int fine = l == 0;
+        reads(cb, la);
+        reads(cb, lb);
+        reads(cb, coarser);
+        writes(cb, v);
+        i32 extra[6] = {(i32)la->sw, (i32)la->sh, coarser ? (i32)coarser->sw : 1, coarser ? (i32)coarser->sh : 1,
+                        coarser ? 1 : 4, (coarser ? 1 : 0) | (fine ? 2 : 0)};
+        if (!pass(cb, P_SEARCH, la->att, lb->att, coarser ? coarser->att : NULL, g_fg.nearest, v, NULL, v->sw, v->sh,
+                  extra))
+            return 0;
+        reads(cb, v);
+        writes(cb, m);
+        i32 mextra[6] = {1, 1, (i32)v->sw, (i32)v->sh, 0, 0};
+        if (!pass(cb, P_MEDIAN, NULL, NULL, v->att, g_fg.nearest, m, NULL, m->sw, m->sh, mextra)) return 0;
+    }
+    return 1;
+}
+
+/* Copy an FSR/float (or filtered) image into an 8-bit present Pic at dw x dh. */
+static int blit_to_pic(VkCommandBuffer cb, Surf* src, Pic* dst, u32 dw, u32 dh) {
+    if (!pic(dst, g_fg.fmt, dw, dh)) return 0;
+    vk_surf_use(cb, src, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, VK_PIPELINE_STAGE_2_BLIT_BIT,
+                VK_ACCESS_2_TRANSFER_READ_BIT);
+    vk_surf_use(cb, &dst->s, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, VK_PIPELINE_STAGE_2_BLIT_BIT,
+                VK_ACCESS_2_TRANSFER_WRITE_BIT);
+    VkImageBlit b = {.srcSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1},
+                     .srcOffsets = {{0, 0, 0}, {(i32)src->sw, (i32)src->sh, 1}},
+                     .dstSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1},
+                     .dstOffsets = {{0, 0, 0}, {(i32)dw, (i32)dh, 1}}};
+    rec_CmdBlitImage(cb, src->img, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, dst->s.img,
+                     VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &b, VK_FILTER_LINEAR);
+    return 1;
+}
+
+/* Warp hist[p]->hist[c] through med[0] into dst at dw x dh. phase_q16 is blend time in [1,65535] (0.5 = 32768). */
+static Surf* fg_warp(VkCommandBuffer cb, Pic* a, Pic* b, Pic* dst, u32 dw, u32 dh, int phase_q16) {
+    if (!pic(dst, g_fg.fmt, dw, dh)) return NULL;
+    cb = vk_cmd(); /* a resize inside pic() waits out the buffer that was recording */
+    reads(cb, &a->s);
+    reads(cb, &b->s);
+    reads(cb, &g_fg.med[0]);
+    writes(cb, &dst->s);
+    if (phase_q16 < 1) phase_q16 = 1;
+    if (phase_q16 > 65535) phase_q16 = 65535;
+    i32 extra[6] = {(i32)dw, (i32)dh, (i32)g_fg.med[0].sw, (i32)g_fg.med[0].sh, phase_q16, 0};
+    if (!pass(cb, P_INTERP, a->rgba8, b->rgba8, g_fg.med[0].att, g_fg.bilinear, NULL, dst->rgba8, dw, dh, extra))
+        return NULL;
+    return &dst->s;
+}
+
+Surf* vk_fg_interpolate(VkCommandBuffer cb) {
+    int c = g_fg.cur, p = c ^ 1;
+    if (!g_fg.have_prev || !g_fg.out.s.img) return NULL;
+    vk_render_end();
+    /* coarse to fine: the 1/16 level searches widely, the finer ones around what the coarser found, each level's
+       motion smoothed by a median before the next starts from it */
+    if (!fg_motion(cb)) goto unavailable;
+    if (!fg_warp(cb, &g_fg.hist[p], &g_fg.hist[c], &g_fg.out, g_fg.w, g_fg.h, 32768)) goto unavailable;
+    vk_render_forget_state();
+    if (++g_fg.made == 1 || g_fg.made % 1800 == 0)
+        LOG("vulkan: frame generation made %llu frames, latest %ux%u\n", (unsigned long long)g_fg.made, g_fg.w,
+            g_fg.h);
+    return &g_fg.out.s;
+unavailable:
+    vk_render_forget_state();
+    return NULL;
+}
+
+/* Fill out_mids[0..nmids-1] at phases (i+1)/(nmids+1) and set *out_cur. nmids is 1..FG_MAX_MIDS.
+   When FSR enlarges, real frames are filtered once into up[]; generated frames warp those. Returns how many
+   generated Surfs were written (0 on failure / first pair). */
+int vk_fg_interpolate_mids(VkCommandBuffer cb, u32 dw, u32 dh, Surf** out_cur, Surf** out_mids, int nmids) {
+    int c = g_fg.cur, p = c ^ 1, i, n = 0;
+    int enlarge = g_settings.upscaler && dw && dh && (dw > g_fg.w || dh > g_fg.h) && dw >= g_fg.w && dh >= g_fg.h;
+    static int native_logged, fsr_skipped_logged;
+    *out_cur = vk_fg_current();
+    if (nmids < 1) nmids = 1;
+    if (nmids > FG_MAX_MIDS) nmids = FG_MAX_MIDS;
+    if (!enlarge) {
+        if (!native_logged) {
+            native_logged = 1;
+            LOG("vulkan: frame generation: FSR enlarge skipped (output is not larger than the game image)\n");
+        }
+        if (!g_fg.have_prev || !g_fg.out.s.img) return 0;
+        vk_render_end();
+        if (!fg_motion(cb)) { vk_render_forget_state(); return 0; }
+        for (i = 0; i < nmids; i++) {
+            int phase = (int)(((long long)(i + 1) << 16) / (nmids + 1));
+            Surf* mid = fg_warp(cb, &g_fg.hist[p], &g_fg.hist[c], &g_fg.mids[i], g_fg.w, g_fg.h, phase);
+            if (!mid) break;
+            out_mids[n++] = mid;
+        }
+        vk_render_forget_state();
+        if (n && (++g_fg.made == 1 || g_fg.made % 1800 == 0))
+            LOG("vulkan: frame generation made %llu frames (%d mids/guest), latest %ux%u\n",
+                (unsigned long long)g_fg.made, n, g_fg.w, g_fg.h);
+        return n;
+    }
+    if (!g_fg.have_prev) return 0;
+    vk_render_end();
+    cb = vk_cmd();
+    if (!fg_motion(cb)) goto failed;
+    if (g_fg.up_w != dw || g_fg.up_h != dh) {
+        g_fg.up_ready[0] = g_fg.up_ready[1] = 0;
+        g_fg.up_w = dw;
+        g_fg.up_h = dh;
+    }
+    {
+        Surf* scaled = vk_present_filters(cb, &g_fg.hist[c].s, 0, 0, g_fg.w, g_fg.h, dw, dh);
+        cb = vk_cmd();
+        if (!scaled || !blit_to_pic(cb, scaled, &g_fg.up[c], dw, dh)) goto fsr_skip;
+        g_fg.up_ready[c] = 1;
+    }
+    if (!g_fg.up_ready[p]) {
+        *out_cur = &g_fg.up[c].s;
+        vk_render_forget_state();
+        return 0;
+    }
+    for (i = 0; i < nmids; i++) {
+        int phase = (int)(((long long)(i + 1) << 16) / (nmids + 1));
+        Surf* mid = fg_warp(cb, &g_fg.up[p], &g_fg.up[c], &g_fg.up_mids[i], dw, dh, phase);
+        if (!mid) break;
+        out_mids[n++] = mid;
+    }
+    vk_render_forget_state();
+    if (n && (++g_fg.made == 1 || g_fg.made % 1800 == 0))
+        LOG("vulkan: frame generation made %llu frames (%d mids/guest), FSR then interpolate %ux%u to %ux%u\n",
+            (unsigned long long)g_fg.made, n, g_fg.w, g_fg.h, dw, dh);
+    *out_cur = &g_fg.up[c].s;
+    return n;
+fsr_skip:
+    if (!fsr_skipped_logged) {
+        fsr_skipped_logged = 1;
+        LOG("vulkan: frame generation: FSR-before-interpolate skipped; native interpolation used\n");
+    }
+    vk_render_forget_state();
+    cb = vk_cmd();
+    *out_cur = vk_fg_current();
+    n = 0;
+    for (i = 0; i < nmids; i++) {
+        int phase = (int)(((long long)(i + 1) << 16) / (nmids + 1));
+        Surf* mid = fg_warp(cb, &g_fg.hist[p], &g_fg.hist[c], &g_fg.mids[i], g_fg.w, g_fg.h, phase);
+        if (!mid) break;
+        out_mids[n++] = mid;
+    }
+    vk_render_forget_state();
+    return n;
+failed:
+    vk_render_forget_state();
+    *out_cur = vk_fg_current();
+    return 0;
+}
+/* One midpoint (phase 0.5) for callers that still expect a single Surf*. */
+Surf* vk_fg_interpolate_present(VkCommandBuffer cb, u32 dw, u32 dh, Surf** out_cur) {
+    Surf* mids[1];
+    int n = vk_fg_interpolate_mids(cb, dw, dh, out_cur, mids, 1);
+    return n > 0 ? mids[0] : NULL;
+}
+
+void vk_fg_reset(void) {
+    g_fg.have_prev = 0;
+    g_fg.up_ready[0] = g_fg.up_ready[1] = 0;
+}
+
+void vk_fg_destroy(void) {
+    for (int i = 0; i < 2; i++) {
+        pic_drop(&g_fg.hist[i]);
+        pic_drop(&g_fg.up[i]);
+        for (int l = 0; l < LEVELS; l++) drop(&g_fg.lum[i][l]);
+    }
+    for (int i = 0; i < FG_MAX_MIDS; i++) {
+        pic_drop(&g_fg.mids[i]);
+        pic_drop(&g_fg.up_mids[i]);
+    }
+    pic_drop(&g_fg.out);
+    for (int l = 0; l < LEVELS; l++) {
+        drop(&g_fg.vec[l]);
+        drop(&g_fg.med[l]);
+    }
+    drop(&g_fg.dummy);
+    drop(&g_fg.dummy_w);
+    pic_drop(&g_fg.dummy8);
+    for (int i = 0; i < PASSES; i++)
+        if (g_fg.pipe[i]) vkDestroyPipeline(g_vk.dev, g_fg.pipe[i], NULL);
+    if (g_fg.nearest) vkDestroySampler(g_vk.dev, g_fg.nearest, NULL);
+    if (g_fg.bilinear) vkDestroySampler(g_vk.dev, g_fg.bilinear, NULL);
+    if (g_fg.layout) vkDestroyPipelineLayout(g_vk.dev, g_fg.layout, NULL);
+    if (g_fg.ds) vkDestroyDescriptorSetLayout(g_vk.dev, g_fg.ds, NULL);
+    memset(&g_fg, 0, sizeof g_fg);
+}
