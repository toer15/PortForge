+            .imageSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1}, .imageExtent = {8, 6, 1}};
+        rec_CmdCopyBufferToImage(cb, staged, src.img, src.layout, 1, &upload);
+        CHECK(!vk_upscale(cb, &src, 0, 0, 8, 6, 8, 6)); /* equal size: retain the original image */
+        CHECK(!vk_upscale(cb, &src, 0, 0, 8, 6, 4, 3)); /* downscaling stays on the standard path */
+        CHECK(!vk_upscale(cb, &src, 7, 0, 4, 6, dw, dh)); /* invalid crop is never read */
+        u64 finishes = g_vk_finishes;
+        Surf* out = vk_upscale(cb, &src, 2, 1, 4, 4, dw, dh);
+        CHECK(out && out->sw == dw && out->sh == dh && g_vk_finishes == finishes);
+        /* Encode to the same display format: sRGB should round-trip once, not be decoded or encoded twice. */
+        VkImage output;
+        VmaAllocation output_mem;
+        ii.extent = (VkExtent3D){dw, dh, 1};
+        ii.usage = VK_IMAGE_USAGE_TRANSFER_DST_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT;
