+                dark += result[i * 4] < 90; light += result[i * 4] > 170;
+                CHECK(abs((int)result[i * 4] - result[i * 4 + 1]) <= 2);
+                CHECK(abs((int)result[i * 4] - result[i * 4 + 2]) <= 2);
+                u32 x = i % dw, y = i / dw;
+                if (x > dw / 4 && x < 3 * dw / 4 && y > dh / 4 && y < 3 * dh / 4 &&
