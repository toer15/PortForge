+    u64 finishes = g_vk_finishes;
+    Surf* out = vk_present_filters(cb, src, 0, 0, w, h, dw, dh);
+    if (!out || out->sw != dw || out->sh != dh || g_vk_finishes != finishes) { *filtered = 0; return NULL; }
+    *filtered = 1;
+    VkImageCreateInfo ii = {.sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO, .imageType = VK_IMAGE_TYPE_2D,
+        .format = src->f.vk, .extent = {dw, dh, 1}, .mipLevels = 1, .arrayLayers = 1,
+        .samples = VK_SAMPLE_COUNT_1_BIT, .tiling = VK_IMAGE_TILING_OPTIMAL,
+        .usage = VK_IMAGE_USAGE_TRANSFER_DST_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT};
+    if (!vk_image_create(&ii, output, output_mem)) return NULL;
+    vk_barrier(cb, *output, VK_IMAGE_ASPECT_COLOR_BIT, VK_PIPELINE_STAGE_2_TOP_OF_PIPE_BIT, 0,
+        VK_IMAGE_LAYOUT_UNDEFINED, VK_PIPELINE_STAGE_2_BLIT_BIT, VK_ACCESS_2_TRANSFER_WRITE_BIT, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL);
+    VkImageBlit blit = {.srcSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1},
+        .srcOffsets = {{0, 0, 0}, {(i32)dw, (i32)dh, 1}}, .dstSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1},
+        .dstOffsets = {{0, 0, 0}, {(i32)dw, (i32)dh, 1}}};
+    rec_CmdBlitImage(cb, out->img, out->layout, *output, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &blit, VK_FILTER_NEAREST);
+    vk_barrier(cb, *output, VK_IMAGE_ASPECT_COLOR_BIT, VK_PIPELINE_STAGE_2_BLIT_BIT, VK_ACCESS_2_TRANSFER_WRITE_BIT,
+        VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, VK_PIPELINE_STAGE_2_COPY_BIT, VK_ACCESS_2_TRANSFER_READ_BIT, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+    u8* result = vk_readback_buffer((u64)dw * dh * 4, readback);
+    if (!result) return NULL;
+    VkBufferImageCopy copy = {.imageSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1}, .imageExtent = {dw, dh, 1}};
+    rec_CmdCopyImageToBuffer(cb, *output, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, *readback, 1, &copy);
+    vk_finish(); vk_readback_ready();
+    return result;
+}
+
+/* The largest change of the dark-to-light edge's height between neighbouring columns, in source rows (64 dark, 192
+   light). Columns at the image's sides are left out: the crop ends the edge there. */
+static float max_edge_jump(const u8* img, u32 dw, u32 dh, u32 scale) {
+    float worst = 0.0f, last = 0.0f;
+    for (u32 x = 2 * scale; x + 2 * scale < dw; x++) {
+        float light = 0.0f;
+        for (u32 y = 0; y < dh; y++) light += ((float)img[(y * dw + x) * 4] - 64.0f) / 128.0f;
+        light /= (float)scale;
+        if (x > 2 * scale && fabsf(light - last) > worst) worst = fabsf(light - last);
+        last = light;
+    }
+    return worst;
+}
+
+/* Pixel smoothing on a shallow staircase (the jagged edge of an aliased line, 4-pixel steps): every column crossing
+   the edge gets in-between shades, so the steps become a slope; areas away from the edge keep their color; off,
+   an invalid crop and a failed format keep the original. Alone and before FSR, UNORM and sRGB. */
+static int check_pixel_smoothing(void) {
+    enum { W = 32, H = 16 };
+    int upscaler = g_settings.upscaler;
+    CHECK(vk_upscale_init());
+    for (int pass = 0; pass < 4; pass++) {
+        int srgb = pass & 1, fsr = pass >= 2;
+        Surf src = {.w = W, .h = H, .sw = W, .sh = H, .layers = 1, .levels = 1,
+            .type = VK_IMAGE_VIEW_TYPE_2D,
+            .f = {.vk = srgb ? VK_FORMAT_R8G8B8A8_SRGB : VK_FORMAT_R8G8B8A8_UNORM, .bpp = 4, .bw = 1, .bh = 1}};
+        VkImageCreateInfo ii = {.sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO, .imageType = VK_IMAGE_TYPE_2D,
+            .format = src.f.vk, .extent = {W, H, 1}, .mipLevels = 1, .arrayLayers = 1,
+            .samples = VK_SAMPLE_COUNT_1_BIT, .tiling = VK_IMAGE_TILING_OPTIMAL,
+            .usage = VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT};
+        VkViewFormats formats;
+        vk_view_formats(&ii, &formats);
+        CHECK(vk_image_create(&ii, &src.img, &src.mem));
+        VkBuffer staged, readback;
+        u64 offset;
+        u8* pixels = vk_stage(W * H * 4, 4, &staged, &offset);
+        CHECK(pixels);
+        /* dark above, light from row first(x) down: the boundary drops one row every 4 columns */
+#define FIRST_LIGHT(x) ((u32)(x) / 4 + 4)
+        for (u32 y = 0; y < H; y++) for (u32 x = 0; x < W; x++) {
+            u8* p = pixels + (y * W + x) * 4;
+            p[0] = p[1] = p[2] = y >= FIRST_LIGHT(x) ? 192 : 64; p[3] = 255;
+        }
+        VkCommandBuffer cb = vk_cmd();
+        vk_surf_use(cb, &src, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, VK_PIPELINE_STAGE_2_COPY_BIT, VK_ACCESS_2_TRANSFER_WRITE_BIT);
+        VkBufferImageCopy upload = {.bufferOffset = offset,
+            .imageSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1}, .imageExtent = {W, H, 1}};
+        rec_CmdCopyBufferToImage(cb, staged, src.img, src.layout, 1, &upload);
+        g_settings.upscaler = 0; g_settings.pixel_smoothing = 0;
+        CHECK(!vk_present_filters(cb, &src, 0, 0, W, H, W, H)); /* both off: the original presentation */
+        g_settings.pixel_smoothing = 1;
+        CHECK(!vk_pixel_smooth(cb, &src, 5, 0, W, H)); /* an invalid crop is never read */
+        g_settings.upscaler = fsr;
+        u32 scale = fsr ? 2 : 1, dw = W * scale, dh = H * scale;
+        VkImage output;
+        VmaAllocation output_mem;
+        int filtered;
+        u8* result = present_through(&src, W, H, dw, dh, &readback, &output, &output_mem, &filtered);
+        CHECK(filtered && result);
+        for (u32 y = 0; y < dh; y++) for (u32 x = 0; x < dw; x++) {
+            u8* p = result + (y * dw + x) * 4;
+            CHECK(p[3] == 255 && abs(p[0] - p[1]) <= 2 && abs(p[0] - p[2]) <= 2);
+            int edge = (int)FIRST_LIGHT(x / scale) * (int)scale, want = (int)y >= edge ? 192 : 64;
+            /* FSR's sharpening may overshoot right at the edge; two source rows away nothing changes */
+            if ((int)y < edge - 2 * (int)scale || (int)y >= edge + 2 * (int)scale) CHECK(abs(p[0] - want) <= 2);
+        }
+        /* Jaggedness: the edge's height in each column, from how much of the column is light, in source rows. A
+           staircase jumps a whole row every 4 columns; an antialiased slope climbs a quarter row per column. */
+        float smoothed = max_edge_jump(result, dw, dh, scale);
+        vk_image_destroy(output, output_mem);
+        float plain = 1.0f; /* the source staircase */
+        if (fsr) { /* FSR alone keeps the steps (EASU is edge-preserving), only rounding their corners */
+            g_settings.pixel_smoothing = 0;
+            u8* fsr_only = present_through(&src, W, H, dw, dh, &readback, &output, &output_mem, &filtered);
+            CHECK(filtered && fsr_only);
+            plain = max_edge_jump(fsr_only, dw, dh, scale);
+            vk_image_destroy(output, output_mem);
+        }
+        printf("pixel smoothing pass %d: largest edge step %.2f rows (without smoothing %.2f)\n", pass, smoothed, plain);
+        CHECK(smoothed <= 0.6f && smoothed < plain * 0.7f);
+#undef FIRST_LIGHT
+        for (int i = 0; i < src.nsv; i++) vkDestroyImageView(g_vk.dev, src.sv[i].v, NULL);
+        vk_image_destroy(src.img, src.mem);
+    }
+    g_settings.pixel_smoothing = 0; g_settings.upscaler = upscaler;
+    vk_upscale_destroy(); vk_finish();
+    puts("PASS Pixel smoothing: staircase edges become slopes alone and before FSR, flat areas and sRGB unchanged, off and invalid crops keep the original, no host wait");
+    return 0;
+}
+
+/* Actual interpolation shaders and image lifetime, without game assets. A textured plane moves eight pixels;
+   its halfway position is known, and a fixed HUD band must remain exact. Include odd sizes, sRGB and BGRA. */
+static u32 fg_pixel(int x, int y, int shift) {
+    if (y < 8) return 0xff3264c8u;
+    x -= shift;
+    u32 v = (u32)(((x + 128) / 8 * 9 + y / 8 * 17) % 127 + 50);
+    return 0xff000000u | v | ((v + 20) << 8) | ((v + 40) << 16);
+}
+static int fg_upload(Surf* src, int shift) {
+    VkBuffer staged; u64 offset;
+    u32* pixels = (u32*)vk_stage((u64)src->w * src->h * 4, 4, &staged, &offset);
+    CHECK(pixels);
+    for (u32 y = 0; y < src->h; y++) for (u32 x = 0; x < src->w; x++)
+        pixels[y * src->w + x] = fg_pixel((int)x, (int)y, shift);
+    VkCommandBuffer cb = vk_cmd();
+    vk_surf_use(cb, src, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, VK_PIPELINE_STAGE_2_COPY_BIT, VK_ACCESS_2_TRANSFER_WRITE_BIT);
+    VkBufferImageCopy copy = {.bufferOffset = offset, .imageSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1},
+                              .imageExtent = {src->w, src->h, 1}};
+    rec_CmdCopyBufferToImage(cb, staged, src->img, src->layout, 1, &copy);
+    return 0;
+}
+static int check_frame_generation(void) {
+    const VkFormat formats[] = {VK_FORMAT_R8G8B8A8_UNORM, VK_FORMAT_R8G8B8A8_SRGB, VK_FORMAT_B8G8R8A8_UNORM};
+    for (int f = 0; f < 3; f++) {
+        u32 w = 96 + (f & 1), h = 64 + (f & 1);
+        Surf src = {.w = w, .h = h, .sw = w, .sh = h, .layers = 1, .levels = 1,
+                    .type = VK_IMAGE_VIEW_TYPE_2D, .f = {.vk = formats[f], .bpp = 4, .bw = 1, .bh = 1}};
+        VkImageCreateInfo ii = {.sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO, .imageType = VK_IMAGE_TYPE_2D,
+            .format = src.f.vk, .extent = {w, h, 1}, .mipLevels = 1, .arrayLayers = 1,
+            .samples = VK_SAMPLE_COUNT_1_BIT, .tiling = VK_IMAGE_TILING_OPTIMAL,
+            .usage = VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT};
+        CHECK(vk_image_create(&ii, &src.img, &src.mem));
+        CHECK(!fg_upload(&src, 0));
+        CHECK(!vk_fg_capture(vk_cmd(), &src, 0, 0, w, h)); /* format/size change: no prior frame */
+        CHECK(vk_fg_current());
+        for (int moving = 0; moving < 2; moving++) {
+            CHECK(!fg_upload(&src, moving ? 8 : 0));
+            CHECK(vk_fg_capture(vk_cmd(), &src, 0, 0, w, h));
+            Surf* mid = vk_fg_interpolate(vk_cmd());
+            CHECK(mid && mid->sw == w && mid->sh == h && mid->f.vk == src.f.vk);
+            VkBuffer rb; u8* result = vk_readback_buffer((u64)w * h * 4, &rb);
+            CHECK(result);
+            VkCommandBuffer cb = vk_cmd();
+            vk_surf_use(cb, mid, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, VK_PIPELINE_STAGE_2_COPY_BIT, VK_ACCESS_2_TRANSFER_READ_BIT);
+            VkBufferImageCopy copy = {.imageSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1}, .imageExtent = {w, h, 1}};
+            rec_CmdCopyImageToBuffer(cb, mid->img, mid->layout, rb, 1, &copy);
+            vk_finish(); vk_readback_ready();
+            u64 error = 0, blend_error = 0;
+            for (u32 y = 0; y < h; y++) for (u32 x = 0; x < w; x++) {
+                u32 expected = fg_pixel((int)x, (int)y, moving ? 4 : 0);
+                u32 before = fg_pixel((int)x, (int)y, 0), after = fg_pixel((int)x, (int)y, moving ? 8 : 0);
+                for (u32 c = 0; c < 3; c++) {
+                    int actual = result[(y * w + x) * 4 + c], want = (expected >> (c * 8)) & 255;
+                    if (!moving || y < 8) CHECK(abs(actual - want) <= 1);
+                    if (moving && y > 16 && x > 16 && x < w - 16) {
+                        error += abs(actual - want);
+                        blend_error += abs((int)((((before >> (c * 8)) & 255) + ((after >> (c * 8)) & 255)) / 2) - want);
+                    }
+                }
+            }
+            if (moving) {
+                printf("frame generation format %d: midpoint error %llu, unwarped blend %llu\n", f,
+                       (unsigned long long)error, (unsigned long long)blend_error);
+                CHECK(error < blend_error * 3 / 4);
+            }
+        }
+        /* Bad crop and disabled/reset history must not interpolate from old pixels. */
+        CHECK(!vk_fg_capture(vk_cmd(), &src, w, 0, w, h));
+        CHECK(!vk_fg_current());
+        CHECK(!vk_fg_capture(vk_cmd(), &src, 0, 0, w, h));
+        vk_fg_reset(); CHECK(!vk_fg_current());
+        vk_finish(); vk_defer_image(src.img, src.mem, VK_NULL_HANDLE, VK_NULL_HANDLE);
+    }
+    vk_fg_destroy();
+    puts("PASS frame generation: stationary colors/HUD, moving midpoint, odd resize, sRGB/BGRA, invalid crop, reset");
+    return 0;
+}
