+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#include "nx/runtime/platform/save_activity.h"
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+int main(void) {
+    assert(!pf_save_message(0));
+    pf_save_begin();
+    assert(!strcmp(pf_save_message(9000000000ull), "Saving..."));
+    pf_save_end(9000000000ull, 1);
+    pf_save_presented(9000000000ull);
+    assert(pf_save_message(10000000000ull));
+    assert(!pf_save_message(11000000000ull));
+    pf_save_begin(); pf_save_end(12000000000ull, 0);
+    pf_save_presented(12000000000ull);
+    assert(!strcmp(pf_save_message(13000000000ull), "Save write failed"));
+    pf_save_begin(); pf_save_end(14000000000ull, 1);
+    pf_save_presented(14000000000ull);
+    assert(!strcmp(pf_save_message(15000000000ull), "Save write failed"));
+    assert(!pf_save_message(19000000000ull));
+    pf_save_begin(); pf_save_end(20000000000ull, 1);
+    assert(pf_save_message(30000000000ull)); /* a ten-second loading pause cannot swallow the notice */
+    pf_save_presented(30000000000ull);
+    assert(pf_save_message(31000000000ull));
+    assert(!pf_save_message(32000000000ull));
+    for (int bits = 0; bits < 32; ++bits) {
+        int hide = pf_hide_cursor(bits & 1, bits & 2, bits & 4, bits & 8, bits & 16);
+        assert(hide == (bits == 7));
+    }
+    puts("save_activity: expiry, write failure, fullscreen/menu/focus/system-key policy passed");
+    return 0;
+}
