+/* PortForge low latency. Windows 11 may run a process it judges in the background on efficiency cores at lower
+   clocks (EcoQoS), and ignores its timeBeginPeriod while its window is covered or minimized: an opt-out of both
+   (PROCESS_POWER_THROTTLING_EXECUTION_SPEED 1, _IGNORE_TIMER_RESOLUTION 4, through SetProcessInformation, which is
+   looked up as older systems lack it). Above-normal priority puts the game's threads ahead of ordinary programs'
+   (a browser, a launcher's updater) without starving the system's own */
+void plat_game_priority(char* why, size_t n) {
+    typedef struct {
+        ULONG Version, ControlMask, StateMask;
+    } PowerThrottling;
+    typedef BOOL(WINAPI * SetInfo)(HANDLE, int, LPVOID, DWORD);
+    PowerThrottling pt = {1, 1 | 4, 0};
+    HMODULE kernel = GetModuleHandleW(L"kernel32.dll");
+    FARPROC f = kernel ? GetProcAddress(kernel, "SetProcessInformation") : NULL;
+    int throttling = 0, priority;
+    if (f) {
+        SetInfo set;
+        memcpy(&set, &f, sizeof set);
+        throttling = set(GetCurrentProcess(), 4 /* ProcessPowerThrottling */, &pt, sizeof pt) != 0;
+    }
+    priority = GetPriorityClass(GetCurrentProcess()) == NORMAL_PRIORITY_CLASS &&
+               SetPriorityClass(GetCurrentProcess(), ABOVE_NORMAL_PRIORITY_CLASS);
+    timer_period_1ms();
+    snprintf(why, n, "%s%s%s", priority ? "above-normal priority" : "",
+             priority && throttling ? ", " : "", throttling ? "no power throttling" : "");
