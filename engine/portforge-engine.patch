+}
+
+/// Compute the square root of a value.
+///
+/// @param [in] c           The value to compute the square root for.
+///
+/// @returns
+/// A square root of the input value.
+///
+/// @ingroup GPUCore
+FfxFloat16x2 ffxSquareRootHalf(FfxFloat16x2 c)
+{
