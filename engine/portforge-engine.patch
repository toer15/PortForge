--- /dev/null
+++ b/src/nx/gpu/vk/shaders/fg.comp
@@ -0,0 +1,162 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// PortForge FSR 3 (from scratch): display-only upscale + frame generation inspired by AMD FSR 3's
+// published optical-flow + interpolation design (GPUOpen manuals), without game motion vectors.
+// Switch titles do not expose MVs/depth to the host, so this is not the AMD FidelityFX SDK plugin.
+// Passes:
+//   FG_LUMA    luminance pyramid (FSR 3 Optical Flow preparation)
+//   FG_SEARCH  hierarchical block matching / SAD (AFMF-style 8x8 family, refined coarse?fine)
+//   FG_MEDIAN  3x3 vector median (FSR 3 OF filtering)
+//   FG_INTERP  bidirectional warp, disocclusion, HUD lock, hole inpainting from the current frame
+#version 450
+layout(local_size_x = 8, local_size_y = 8) in;
+layout(binding = 0) uniform sampler2D srcA;
+layout(binding = 1) uniform sampler2D srcB;
+layout(binding = 2) uniform sampler2D srcC;
+layout(binding = 3, rgba16f) uniform writeonly image2D dst;
+layout(binding = 4, rgba8) uniform writeonly image2D dst8;
+layout(push_constant) uniform Push {
+    ivec2 dsize;
+    ivec2 asize;
+    ivec2 csize;
+    int radius;
+    int flags; // SEARCH: 1=coarser motion, 2=subpixel; INTERP unused
+} pc;
+
+float luma(vec3 c) { return dot(c, vec3(0.299, 0.587, 0.114)); }
+
+#if defined(FG_LUMA)
+void main() {
+    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
+    if (any(greaterThanEqual(p, pc.dsize))) return;
+    vec2 uv = (vec2(p) + 0.5) / vec2(pc.dsize);
+    float l = 0.0;
+    if (pc.flags != 0) {
+        for (int y = 0; y < 2; y++) for (int x = 0; x < 2; x++)
+            l += luma(texture(srcA, uv + (vec2(x, y) * 2.0 - 1.0) / vec2(pc.asize)).rgb) * 0.25;
+    } else l = luma(texture(srcA, uv).rgb);
+    imageStore(dst, p, vec4(l, l, l, 1.0));
+}
+#elif defined(FG_SEARCH)
+float la(ivec2 q) { return texelFetch(srcA, clamp(q, ivec2(0), pc.asize - 1), 0).r; }
+float lb(ivec2 q) { return texelFetch(srcB, clamp(q, ivec2(0), pc.asize - 1), 0).r; }
+// 5x5 SAD (~AFMF 8x8 once the pyramid scale is included). The finest level keeps this
+// window: a 3x3 there missed the block match the midpoint test checks. Cost is cut by
+// radius (1 on fine levels, 4 on the coarsest) rather than a smaller window.
+float sad(ivec2 p, ivec2 h) {
+    float s = 0.0;
+    for (int y = -2; y <= 2; y++)
+        for (int x = -2; x <= 2; x++) {
+            ivec2 q = p + ivec2(x, y);
+            s += abs(la(q - h) - lb(q + h));
+        }
+    return s * (1.0 / 25.0);
+}
+float cost(ivec2 p, ivec2 h, vec2 pred) {
+    return sad(p, h) + 0.004 * (abs(float(h.x) - pred.x) + abs(float(h.y) - pred.y)) + 0.0008 * float(abs(h.x) + abs(h.y));
+}
+vec2 coarse(ivec2 p) {
+    ivec2 c = clamp(p / 2, ivec2(0), pc.csize - 1);
+    return texelFetch(srcC, c, 0).xy * 2.0;
+}
+void main() {
+    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
+    if (any(greaterThanEqual(p, pc.dsize))) return;
+    ivec2 best = ivec2(0);
+    vec2 pred = vec2(0.0);
+    float bc = cost(p, best, pred);
+    float zero_sad = bc;
+    // Hard cut: zero motion. 0.55 still catches a cut and lets a detailed pan search.
+    if (zero_sad > 0.55) {
+        imageStore(dst, p, vec4(0.0, 0.0, zero_sad, 1.0));
+        return;
+    }
+    if ((pc.flags & 1) != 0) {
+        for (int i = 0; i < 5; i++) {
+            ivec2 o = i == 0 ? ivec2(0) : i == 1 ? ivec2(-2, 0) : i == 2 ? ivec2(2, 0) : i == 3 ? ivec2(0, -2) : ivec2(0, 2);
+            vec2 c = coarse(p + o);
+            ivec2 h = ivec2(round(c));
+            float k = cost(p, h, c);
+            if (k < bc) { bc = k; best = h; pred = c; }
+        }
+    }
+    ivec2 centre = best;
