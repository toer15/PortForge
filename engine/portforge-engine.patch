+/* Real FSR shaders: crop/color/resize invariants plus a diagonal-edge comparison against linear scaling. */
+static int check_upscaler(void) {
+    CHECK(vk_upscale_init());
+    for (int pass = 0; pass < 8; pass++) {
+        int srgb = pass & 1;
+        int edge = pass >= 4;
+        u32 dw = pass % 4 < 2 ? 23 : 31, dh = pass % 4 < 2 ? 13 : 17;
+        Surf src = {.w = 8, .h = 6, .sw = 8, .sh = 6, .layers = 1, .levels = 1,
+            .type = VK_IMAGE_VIEW_TYPE_2D,
+            .f = {.vk = srgb ? VK_FORMAT_R8G8B8A8_SRGB : VK_FORMAT_R8G8B8A8_UNORM, .bpp = 4, .bw = 1, .bh = 1}};
+        VkImageCreateInfo ii = {.sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO, .imageType = VK_IMAGE_TYPE_2D,
+            .format = src.f.vk, .extent = {8, 6, 1}, .mipLevels = 1, .arrayLayers = 1,
+            .samples = VK_SAMPLE_COUNT_1_BIT, .tiling = VK_IMAGE_TILING_OPTIMAL,
+            .usage = VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT};
+        VkViewFormats formats;
+        vk_view_formats(&ii, &formats);
+        CHECK(vk_image_create(&ii, &src.img, &src.mem));
+        VkBuffer staged, readback;
+        u64 offset;
+        u8* pixels = vk_stage(8 * 6 * 4, 4, &staged, &offset);
+        CHECK(pixels);
+        for (u32 y = 0; y < 6; y++) for (u32 x = 0; x < 8; x++) {
+            int inside = x >= 2 && x < 6 && y >= 1 && y < 5;
+            u8* p = pixels + (y * 8 + x) * 4;
+            p[0] = inside ? 64 : 255; p[1] = inside ? 128 : 0; p[2] = inside ? 192 : 0; p[3] = 255;
+            if (edge && inside) p[0] = p[1] = p[2] = x - 2 >= y - 1 ? 192 : 64;
+        }
+        VkCommandBuffer cb = vk_cmd();
+        vk_surf_use(cb, &src, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, VK_PIPELINE_STAGE_2_COPY_BIT, VK_ACCESS_2_TRANSFER_WRITE_BIT);
