+/* PortForge: a draw's new pipeline goes to the front of the draws' queue, and one the draw may skip (vk_pipeline_skippable)
+   moves to the back. A bind that must wait for its pipeline (a loading screen, an image drawn once) used to queue behind
+   every pipeline of the 3D world, which are skipped while they are made: one game's loading screen waited 1.6 s for 13
+   pipelines of 125 ms each, with hundreds of skippable ones ahead of them. */
+static void pipe_queue_front(Pipe* e) {
+    e->job = g_pj_head;
+    g_pj_head = e;
+    if (!g_pj_tail) g_pj_tail = e;
+    e->queued = 1;
+    pc_signal(&g_pj_work);
+}
+/* e out of the draws' queue (g_pj_lock held): 1 when it was in it */
+static int pipe_dequeue_draw(Pipe* e) {
+    Pipe *q, *before = NULL;
+    if (e->queued != 1) return 0;
+    for (q = g_pj_head; q && q != e; q = q->job) before = q;
+    if (!q) return 0;
+    if (before)
+        before->job = e->job;
+    else
+        g_pj_head = e->job;
+    if (g_pj_tail == e) g_pj_tail = before;
+    e->job = NULL;
+    e->queued = 0;
+    return 1;
+}
