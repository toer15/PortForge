diff --git a/src/nx/gpu/vk/frame_policy.h b/src/nx/gpu/vk/frame_policy.h
new file mode 100644
index 0000000..147ff8e
--- /dev/null
+++ b/src/nx/gpu/vk/frame_policy.h
@@ -0,0 +1,24 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#ifndef PF_FRAME_POLICY_H
+#define PF_FRAME_POLICY_H
+#include <stdint.h>
+
+#define PF_FRAME_WAIT_NS UINT64_C(1500000)
+typedef struct { uint64_t spent; } PfFrameBudget;
+static inline uint64_t pf_frame_allowance(const PfFrameBudget* b) {
+    return b->spent < PF_FRAME_WAIT_NS ? PF_FRAME_WAIT_NS - b->spent : 0;
+}
+static inline void pf_frame_charge(PfFrameBudget* b, uint64_t elapsed) {
+    uint64_t left = pf_frame_allowance(b);
+    b->spent += elapsed < left ? elapsed : left;
+}
+static inline int pf_shader_workers(int setting, int cpus) {
+    if (setting > 0) return setting > 32 ? 32 : setting;
+    if (cpus > 0 && cpus <= 4) return 1;
+    int n = cpus / 4;
+    return n < 2 ? 2 : n > 6 ? 6 : n;
+}
+static inline int pf_background_workers(int workers, int guard) {
+    return guard && workers > 1 ? workers - 1 : workers;
+}
+#endif
diff --git a/src/nx/gpu/vk/frame_times.c b/src/nx/gpu/vk/frame_times.c
new file mode 100644
index 0000000..faec9fa
--- /dev/null
+++ b/src/nx/gpu/vk/frame_times.c
@@ -0,0 +1,35 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#include <stdlib.h>
+#include <string.h>
+#include "nx/gpu/vk/vk.h"
+
+#define FRAME_TIME_WINDOW 600
+
+typedef struct {
+    u64 ns[FRAME_TIME_WINDOW];
+    u32 count;
+} FrameTimes;
+static FrameTimes g_frame_times;
+
+static int frame_time_compare(const void* a, const void* b) {
+    u64 x = *(const u64*)a, y = *(const u64*)b;
+    return x < y ? -1 : x > y;
+}
+
+void vk_frame_time_add(u64 ns) {
+    if (g_frame_times.count < FRAME_TIME_WINDOW) g_frame_times.ns[g_frame_times.count++] = ns;
+}
+
+u64 vk_frame_time_p99(u32* count) {
+    u64 ordered[FRAME_TIME_WINDOW], result = 0;
+    u32 n = g_frame_times.count;
+    *count = n;
+    if (n) {
+        u32 at = (n * 99 + 99) / 100 - 1;
+        memcpy(ordered, g_frame_times.ns, n * sizeof *ordered);
+        qsort(ordered, n, sizeof *ordered, frame_time_compare);
+        result = ordered[at];
+    }
+    g_frame_times.count = 0;
+    return result;
+}
