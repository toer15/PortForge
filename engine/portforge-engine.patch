+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#ifndef PF_RENDER_SCALE_H
+#define PF_RENDER_SCALE_H
+/* Render targets can hold game data, not just pictures. Until scaling propagates correctly through all sampled,
+   storage, query and writeback paths, preserve their native dimensions. Presentation upscaling is independent. */
+static inline float pf_render_scale(float requested, int protect_graphics) {
+    if (protect_graphics || !(requested >= 0.25f && requested <= 4.0f)) return 1.0f;
+    return requested;
+}
+#endif
