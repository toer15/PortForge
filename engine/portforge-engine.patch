+/* Present src's crop through the filters into an image of src's format, read back as RGBA8 (NULL: not filtered). */
+static u8* present_through(Surf* src, u32 w, u32 h, u32 dw, u32 dh, VkBuffer* readback, VkImage* output,
+                           VmaAllocation* output_mem, int* filtered) {
