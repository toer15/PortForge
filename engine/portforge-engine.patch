new file mode 100644
index 0000000..3a4d381
--- /dev/null
+++ b/src/nx/memory/layout.h
@@ -0,0 +1,31 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later
+   Copyright 2026 the ScarletNX contributors */
+/* 64-bit applications choose their address width in NPDM, independently of the host PC. */
+#ifndef SNX_MEMORY_LAYOUT_H
+#define SNX_MEMORY_LAYOUT_H
+#include "nx/memory/mem.h"
+
+#define SNX_LAYOUT39_INITIALIZER                                                                                       \
+    {0x8000000ull, AS_SIZE, 0x1100000000ull, 0x200000000ull, 0x100000000ull, 0x1000000000ull,                            \
+     0x1300000000ull, 0x80000000ull, 0x1380000000ull, 0x13C0000000ull}
+
+static inline MemLayout snx_memory_layout64(unsigned aspace) {
+    MemLayout layout = SNX_LAYOUT39_INITIALIZER;
+    if (aspace == 1) {
+        /* A 36-bit application's code, stacks and kernel mappings share the region below 2 GiB.
+           The large region starts at 2 GiB: 6 GiB of alias space, then an 8 GiB heap. In particular,
+           neither a stack nor TLS may be above bit 35: older SDK buffer descriptors discard those bits. */
+        layout.base = 0x8000000ull;
+        layout.end = 0x1000000000ull;
+        layout.alias = 0x80000000ull;
+        layout.alias_size = 0x180000000ull;
+        layout.heap = 0x200000000ull;
+        layout.heap_size = 0x200000000ull;
+        layout.stack = layout.base;
+        layout.stack_size = layout.alias - layout.base;
+        layout.kern = layout.base;
+        layout.kern_end = layout.alias;
+    }
+    return layout;
+}
+#endif
