diff --git a/tests/frame_policy.c b/tests/frame_policy.c
new file mode 100644
index 0000000..8404f8a
--- /dev/null
+++ b/tests/frame_policy.c
@@ -0,0 +1,36 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#include "nx/gpu/vk/frame_policy.h"
+#include <assert.h>
+#include <stdio.h>
+
+int main(void) {
+    PfFrameBudget frame = {0};
+    uint64_t waited = 0;
+    /* A cold scene asks for 1000 pipelines. Each might have taken 1.5 ms independently before. */
+    for (int i = 0; i < 1000; i++) {
+        uint64_t delay = pf_frame_allowance(&frame);
+        if (delay > 500000) delay = 500000;
+        waited += delay;
+        pf_frame_charge(&frame, delay);
+    }
+    assert(waited == PF_FRAME_WAIT_NS && !pf_frame_allowance(&frame));
+    frame.spent = 0;
+    assert(pf_frame_allowance(&frame) == PF_FRAME_WAIT_NS);
+    pf_frame_charge(&frame, UINT64_MAX); /* a mandatory wait or an OS oversleep exhausts the optional budget */
+    assert(!pf_frame_allowance(&frame) && frame.spent == PF_FRAME_WAIT_NS);
+    pf_frame_charge(&frame, UINT64_MAX);
+    assert(frame.spent == PF_FRAME_WAIT_NS);
+    assert(pf_shader_workers(0, 2) == 1 && pf_shader_workers(0, 4) == 1);
+    assert(pf_shader_workers(0, 8) == 2 && pf_shader_workers(0, 16) == 4);
+    assert(pf_shader_workers(0, 64) == 6 && pf_shader_workers(0, 0) == 2);
+    assert(pf_shader_workers(1, 64) == 1 && pf_shader_workers(32, 2) == 32);
+    assert(pf_shader_workers(100, 8) == 32);
+    assert(pf_shader_workers_on(0, 8, 8) == 4 && pf_shader_workers_on(0, 16, 8) == 4);
+    assert(pf_shader_workers_on(0, 12, 6) == 3 && pf_shader_workers_on(0, 32, 16) == 6);
+    assert(pf_shader_workers_on(0, 8, 4) == 2 && pf_shader_workers_on(0, 4, 4) == 1 && pf_shader_workers_on(0, 0, 0) == 2);
+    assert(pf_shader_workers_on(3, 16, 8) == 3);
+    assert(pf_background_workers(1, 1) == 1 && pf_background_workers(2, 1) == 1);
+    assert(pf_background_workers(6, 1) == 5 && pf_background_workers(6, 0) == 6);
+    puts("frame policy: burst budget, reset, oversleep, CPU counts and demand reservation passed");
+    return 0;
+}
diff --git a/tests/frame_times.c b/tests/frame_times.c
new file mode 100644
index 0000000..17e9fa2
--- /dev/null
+++ b/tests/frame_times.c
@@ -0,0 +1,21 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#include <stdio.h>
+#include "nx/gpu/vk/vk.h"
+
+int main(void) {
+    u32 count;
+    u64 p99;
+    for (u64 i = 1; i <= 100; i++) vk_frame_time_add(i * 1000000ull);
+    p99 = vk_frame_time_p99(&count);
+    if (count != 100 || p99 != 99000000ull) {
+        fprintf(stderr, "p99 of 1..100 ms: got %u samples, %llu ns\n", count, (unsigned long long)p99);
+        return 1;
+    }
+    p99 = vk_frame_time_p99(&count);
+    if (count || p99) {
+        fprintf(stderr, "p99 window did not reset: got %u samples, %llu ns\n", count, (unsigned long long)p99);
+        return 1;
+    }
+    puts("frame time p99: PASS");
+    return 0;
+}
diff --git a/tests/frame_trace.c b/tests/frame_trace.c
new file mode 100644
index 0000000..eafe9e1
--- /dev/null
+++ b/tests/frame_trace.c
@@ -0,0 +1,87 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+/* The frame-time trace (runtime/platform/frame_trace.c): hitch detection, cause attribution, the CSV and the graph */
+#include "nx/runtime/platform/frame_trace.h"
+#include "nx/runtime/platform/plat.h"
+#include <assert.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <string.h>
+
+/* ui.c's lock and warning, without the platform layer */
+void pm_lock(PMutex* m) { (void)m; }
+void pm_unlock(PMutex* m) { (void)m; }
+void logf_(int lvl, const char* fmt, ...) {
+    (void)lvl;
+    (void)fmt;
+}
+
+int main(void) {
+    static PfTrace t;
+    unsigned long long part[PF_PARTS] = {0}, count[PF_COUNTS] = {0};
+    int i;
+    /* a quiet frame is the game's; a part names the frame only as a real share of it */
+    assert(pf_trace_cause(part, 33) == PF_CAUSE_GAME);
+    part[PF_PART_FILES] = 3;
+    assert(pf_trace_cause(part, 8) == PF_CAUSE_GAME); /* under 4 ms is noise */
+    part[PF_PART_FILES] = 30;
+    part[PF_PART_PIPELINES] = 400;
+    assert(pf_trace_cause(part, 500) == PF_PART_PIPELINES);
+    assert(pf_trace_cause(part, 2000) == PF_CAUSE_GAME); /* 400 of 2000: under a quarter */
+    part[PF_PART_PIPELINES] = 0;
+    part[PF_PART_JIT] = 90;
+    assert(pf_trace_cause(part, 120) == PF_PART_JIT);
+    assert(!strcmp(pf_trace_cause_name(PF_PART_JIT), "game code compiling"));
+
+    /* before 30 frames are known only 50 ms counts as a hitch; then twice the typical frame, at least 25 ms */
+    assert(!pf_trace_add(&t, 40.0f, PF_CAUSE_GAME) && pf_trace_add(&t, 60.0f, PF_CAUSE_GAME));
+    for (i = 0; i < 100; ++i) assert(!pf_trace_add(&t, 16.7f, PF_CAUSE_GAME));
+    assert(pf_trace_typical(&t) > 16.6f && pf_trace_typical(&t) < 16.8f);
+    assert(!pf_trace_is_hitch(&t, 24.0f) && !pf_trace_is_hitch(&t, 33.0f) && pf_trace_is_hitch(&t, 34.0f));
+    assert(pf_trace_add(&t, 512.0f, PF_PART_SHADERS) && t.hitches == 2 && t.last_hitch_cause == PF_PART_SHADERS);
+    /* a 30 FPS game's frames are no hitches, and the ring keeps the last PF_TRACE_FRAMES */
+    for (i = 0; i < 2 * PF_TRACE_FRAMES; ++i) pf_trace_add(&t, 33.3f, PF_CAUSE_GAME);
+    assert(t.count == PF_TRACE_FRAMES && t.hitches == 2 && pf_trace_typical(&t) > 33.2f);
+    assert(!pf_trace_is_hitch(&t, 50.0f) && pf_trace_is_hitch(&t, 70.0f));
+
+    /* the CSV: a header and one line a frame with as many fields */
+    {
+        char buf[2048], *nl;
+        FILE* f = fopen("frame_trace_test.csv", "w+"); /* tmpfile writes to the drive's root on Windows */
+        static const char HEAD[] = "frame,time_s,frame_ms,hitch,cause,shaders_ms",
+                          LINE[] = "7,1.500,120.00,1,game code compiling,0,0,0,0,0,30,0,0,90,";
+        int header = 1, fields;
+        assert(f);
+        pf_trace_csv_header(f);
+        count[PF_COUNT_JIT] = 2;
+        pf_trace_csv_line(f, 7, 1.5, 120.0f, part, count, PF_PART_JIT, 1);
+        rewind(f);
+        while (fgets(buf, sizeof buf, f)) {
+            const char* c;
+            for (fields = 1, c = buf; *c; ++c) fields += *c == ',';
+            assert(fields == 5 + PF_PARTS + PF_COUNTS);
+            nl = strchr(buf, '\n');
+            assert(nl);
+            if (header)
+                assert(!strncmp(buf, HEAD, sizeof HEAD - 1));
+            else
+                assert(!strncmp(buf, LINE, sizeof LINE - 1));
+            header = 0;
+        }
+        fclose(f);
+        remove("frame_trace_test.csv");
+    }
+
+    /* the graph: a panel, a bar a frame, a hitch red */
+    {
+        static SnxUiQuad quads[1024];
+        SnxUiList l = {quads, 0, 1024};
+        const int safe[4] = {0, 0, 1920, 1080};
+        int red = 0;
+        pf_trace_add(&t, 400.0f, PF_PART_FILES);
+        pf_trace_draw(&t, &l, safe, 1080, 120);
+        for (i = 0; i < l.n; ++i) red += quads[i].rgba == (255u | 48u << 8 | 48u << 16 | 255u << 24);
+        assert(l.n > PF_TRACE_FRAMES && red == 1);
+    }
+    puts("frame trace: PASS");
+    return 0;
+}
