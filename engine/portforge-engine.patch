+/* PortForge crash guard: guarded scratch pages, zero at first. A page's first touch raises a guard-page exception,
+   which is logged here and retried; the page is then plain memory, so a null pointer's reads and writes land there */
+static u8* g_guard_base;
+static u64 g_guard_size;
+static LONG WINAPI null_guard_note(EXCEPTION_POINTERS* e) {
+    EXCEPTION_RECORD* r = e->ExceptionRecord;
+    u8* at;
+    if (r->ExceptionCode != EXCEPTION_GUARD_PAGE || r->NumberParameters < 2) return EXCEPTION_CONTINUE_SEARCH;
+    at = (u8*)r->ExceptionInformation[1];
+    if (!g_guard_base || at < g_guard_base || at >= g_guard_base + g_guard_size) return EXCEPTION_CONTINUE_SEARCH;
+    WARN("crash guard: the game %s its memory at %llx through a null pointer (host pc %p); it lands in a scratch page and "
+         "goes on\n",
+         r->ExceptionInformation[0] == 1 ? "wrote" : "read", (unsigned long long)(at - g_guard_base),
+         r->ExceptionAddress);
+    return EXCEPTION_CONTINUE_EXECUTION;
+}
+int plat_vm_null_guard(u8* p, u64 size) {
+    if (!VirtualAlloc(p, (SIZE_T)size, MEM_COMMIT, PAGE_READWRITE | PAGE_GUARD)) return -1;
+    g_guard_size = size;
+    __atomic_store_n(&g_guard_base, p, __ATOMIC_RELEASE);
+    return AddVectoredExceptionHandler(1, null_guard_note) ? 0 : -1;
+}
